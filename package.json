{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "clean": "node -e \"try { require('fs').rmSync('dist', {recursive:true,force:true,maxRetries:5,retryDelay:200}); } catch(e){}\" && echo dist cleaned",
    "build:clean": "pnpm run clean && prisma generate && pnpm run build",
    "dev": "nest start --watch",
    "dev:infra": "docker compose up -d db redis worker clsi realtime",
    "infra:min": "docker compose up -d db redis",
    "infra:all": "docker compose up -d db redis worker clsi realtime",
    "infra:realtime": "docker compose up -d --build realtime",
    "infra:stop": "docker compose stop",
    "infra:down": "docker compose down",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:clsi": "tsc -p tsconfig.clsi.json && tsc-alias -p tsconfig.clsi.json",
    "build:realtime": "tsc -p tsconfig.realtime.json && tsc-alias -p tsconfig.realtime.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:realtime": "node dist/realtime.js",
    "dev:realtime": "nest start --watch --entryFile realtime",
    "start:clsi": "node dist/clsi.js",
    "dev:clsi": "nest start --watch --entryFile clsi",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:light": "pnpm build && node --max-old-space-size=512 dist/main.js",
    "clean:ports": "powershell -Command \"Get-NetTCPConnection -LocalPort 18300,18295 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "verify:oxlint": "oxlint --config .oxlintrc.json src scripts",
    "verify:format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "verify:gates": "ts-node --transpile-only scripts/gates/run-gates.ts",
    "verify:gates:prune": "ts-node --transpile-only scripts/gates/run-gates.ts --prune",
    "verify:diff-cov": "ts-node --transpile-only scripts/gates/verify-diff-coverage.ts --base=origin/master --min=80",
    "test:ci": "ts-node --transpile-only scripts/gates/run-unit-tests-ci.ts",
    "openapi:export": "node scripts/ops/export-openapi.mjs",
    "verify:openapi": "node scripts/ops/export-openapi.mjs --check",
    "verify:arch": "depcruise src --config .dependency-cruiser.js --ignore-known .dependency-cruiser-known-violations.json",
    "verify:arch:baseline": "depcruise src --config .dependency-cruiser.js --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "verify:dup": "jscpd --config .jscpd.json",
    "verify:deadcode": "knip",
    "verify:quick": "pnpm run verify:oxlint && pnpm run verify:gates && pnpm run test:changed",
    "verify:ci": "pnpm run verify:oxlint && pnpm run verify:gates && pnpm run verify:arch && pnpm run verify:dup && pnpm run typecheck && pnpm run build",
    "test": "jest --forceExit",
    "test:changed": "jest --onlyChanged --passWithNoTests --forceExit",
    "test:library": "jest test/unit/library --forceExit",
    "test:pages": "jest test/unit/pages --forceExit",
    "test:experiments": "jest test/unit/experiments --forceExit",
    "test:files": "jest test/unit/files --forceExit",
    "test:work-item": "jest test/unit/work-item --forceExit",
    "test:identity": "jest test/unit/identity --forceExit",
    "test:chat": "jest test/unit/chat --forceExit",
    "test:core": "jest test/unit/core --forceExit",
    "test:ai": "jest test/unit/ai --forceExit",
    "test:project": "jest test/unit/project --forceExit",
    "test:analytics": "jest test/unit/project/analytics --forceExit",
    "test:sticky": "jest test/unit/sticky --forceExit",
    "test:realtime": "jest test/unit/realtime --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "seed:retractions": "ts-node -r tsconfig-paths/register scripts/ops/seed-retractions.ts",
    "audit:security": "pnpm audit",
    "prepare": "lefthook install"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@citation-js/core": "^0.7.17",
    "@citation-js/plugin-bibtex": "^0.7.17",
    "@citation-js/plugin-csl": "^0.7.17",
    "@citation-js/plugin-ris": "^0.7.17",
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.9",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.2.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-vi": "^3.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "ioredis": "^5.4.2",
    "isomorphic-git": "^1.44.19",
    "jsdom": "^30.0.1",
    "lib0": "^0.2.118",
    "lru-cache": "^11.5.3",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "tsconfig-paths": "^4.2.0",
    "unpdf": "^1.8.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/diff": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nspell": "^2.1.6",
    "@types/pg": "^8.21.0",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^9.18.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jscpd": "^5.4.3",
    "knip": "^6.49.0",
    "lefthook": "^2.2.4",
    "oxlint": "^1.95.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/(unit|integration|smoke|architecture|contracts)/.*\\.(spec|interface-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup-jest.ts"
    ],
    "testTimeout": 60000
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "@napi-rs/canvas",
      "tesseract.js",
      "unrs-resolver"
    ],
    "overrides": {
      "qs": "^6.16.0",
      "fast-uri": ">=4.1.3",
      "js-yaml": ">=5.2.2",
      "deepmerge-ts": ">=8.0.0",
      "multer": "2.3.0"
    }
  }
}
