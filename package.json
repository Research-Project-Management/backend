{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "clean": "node -e \"try { require('fs').rmSync('dist', {recursive:true,force:true,maxRetries:5,retryDelay:200}); } catch(e){}\" && echo dist cleaned",
    "prebuild": "pnpm run clean && prisma generate",
    "dev": "nest start --watch",
    "dev:env": "node scripts/start-env.mjs",
    "dev:infra": "docker compose up -d db redis grobid translator worker clsi",
    "start:env": "node scripts/start-env.mjs",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:light": "pnpm build && node --max-old-space-size=512 dist/main.js",
    "clean:ports": "node scripts/clean-ports.mjs",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:changed": "jest --onlyChanged --passWithNoTests --forceExit",
    "test:smoke": "jest test/smoke --forceExit",
    "test:help": "node scripts/test-help.mjs",
    "test:library": "jest test/unit/library --forceExit",
    "test:manuscripts": "jest test/unit/manuscripts --forceExit",
    "test:storage": "jest test/unit/storage --forceExit",
    "test:work-item": "jest test/unit/work-item --forceExit",
    "test:identity": "jest test/unit/identity --forceExit",
    "test:ai": "jest test/unit/ai --forceExit",
    "test:project": "jest test/unit/project --forceExit",
    "test:analytics": "jest test/unit/analytics --forceExit",
    "test:integrations": "jest test/unit/integrations --forceExit",
    "test:sticky": "jest test/unit/sticky --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "test:db-suites": "jest --testPathPatterns=\"test/integration\" --runInBand --forceExit",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "codebase:sync": "node ../.agents/scripts/sync-codebase.mjs backend",
    "typecheck": "tsc --noEmit",
    "audit:dry": "npx --yes jscpd --threshold 5 -i \"**/*.json\" src",
    "audit:circular": "npx --yes madge --circular --extensions ts src",
    "audit:security": "pnpm audit",
    "audit:quality": "pnpm typecheck && pnpm audit:circular && pnpm audit:dry",
    "sync:zotero-schema": "node scripts/sync-zotero-schema.mjs",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@citation-js/core": "^0.7.17",
    "@citation-js/plugin-bibtex": "^0.7.17",
    "@citation-js/plugin-csl": "^0.7.17",
    "@citation-js/plugin-ris": "^0.7.17",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.9",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.2.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dompurify": "^3.4.15",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.2",
    "jsdom": "^30.0.1",
    "lib0": "^0.2.118",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/(unit|integration|smoke|architecture|contracts)/.*\\.(spec|interface-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup-jest.ts"
    ],
    "testTimeout": 60000
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "@napi-rs/canvas",
      "tesseract.js",
      "unrs-resolver"
    ],
    "overrides": {
      "qs": "^6.16.0",
      "fast-uri": ">=4.1.3",
      "js-yaml": ">=5.2.2",
      "deepmerge-ts": ">=8.0.0",
      "multer": "2.3.0"
    }
  }
}
