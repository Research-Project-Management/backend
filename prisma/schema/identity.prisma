// -- 1. Identity Bounded Context (Identity Domain) ----------------------------

enum UserStatus {
  active
  suspended
  pending_verification
  deactivated
}

enum AuthProvider {
  google
  github
  orcid
  saml
  local
}

enum AuditOutcome {
  success
  failure
  denied
}

enum AuditSeverity {
  info
  warning
  error
  critical
}

enum VerificationTokenType {
  email_verification
  password_reset
}

enum ThemePreference {
  light
  dark
  system
}

model User {
  id        String     @id @default(uuid(7)) @db.Uuid
  email     String     @unique
  password  String?    @map("password_hash")
  status    UserStatus @default(pending_verification)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Identity Internal Relations (100% Isolated)
  profile            UserProfile?
  settings           UserSettings?
  accounts           UserAccount[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]          @relation("AuditActor")

  // Collaborative Project Relations (Clean & Two-Tier)
  createdProjects       Project[]         @relation("ProjectCreator")
  projectMembers        ProjectMember[]   @relation("UserProjectMemberships")
  projectFavorites      ProjectFavorite[] @relation("UserProjectFavorites")
  labels                Label[]           @relation("UserLabels")
  assignedProjectLabels ProjectLabel[]    @relation("ProjectLabelAssigner")
  projectTemplates      ProjectTemplate[] @relation("UserProjectTemplates")
  projectUpdates        ProjectUpdate[]   @relation("UserProjectUpdates")

  // Storage Relations (Personal Scope & File Sharing)
  authoredFiles File[]      @relation("UserFiles")
  sharedFiles   FileShare[] @relation("UserSharedFiles")

  // Work-Item Relations (Collaborative Issue Tracking)
  authoredCycles        Cycle[]
  userActivityEvents    ActivityEvent[]       @relation("UserActivityEvents")
  createdWorkItems      WorkItem[]            @relation("WorkItemAuthor")
  assignedWorkItems     WorkItem[]            @relation("WorkItemAssignee")
  workItemComments      WorkItemComment[]
  createdViews          WorkItemView[]        @relation("ViewAuthor")
  viewFavorites         ViewFavorite[]
  userProperties        ProjectUserProperty[]
  userDrafts            WorkItemDraft[]       @relation("UserDrafts")
  userTemplates         WorkItemTemplate[]    @relation("UserTemplates")
  userAttachments       EntityAttachment[]    @relation("UserAttachments")
  createdWorkItemLabels WorkItemLabel[]       @relation("UserCreatedWorkItemLabels")
  workItemCoAssignments WorkItemAssignee[]    @relation("WorkItemCoAssignees")

  // AI & Intelligence Relations (Unified Copilot & Chat History)
  aiChats AiChat[] @relation("UserAiChats")

  // Sticky Notes & Canvas Relations
  stickies Sticky[] @relation("UserStickies")

  @@index([email])
  @@index([status, deletedAt])
  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("User")
  avatar      String?  @map("avatar_url")
  institution String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@index([institution])
  @@map("user_profiles")
}

model UserSettings {
  userId       String          @id @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        ThemePreference @default(system)
  locale       String          @default("en")
  editorConfig Json            @default("{}") @map("editor_config")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_settings")
}

model UserAccount {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id")
  email             String?
  profileData       Json?        @map("profile_data")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerSubjectId])
  @@unique([userId, provider])
  @@index([email])
  @@map("user_accounts")
}

model RefreshToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique @map("token_hash")
  familyId   String         @default(uuid(7)) @map("family_id") @db.Uuid
  parentId   String?        @map("parent_id") @db.Uuid
  parent     RefreshToken?  @relation("TokenLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children   RefreshToken[] @relation("TokenLineage")
  isRevoked  Boolean        @default(false) @map("is_revoked")
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  userAgent  String?        @map("user_agent")
  ipAddress  String?        @map("ip_address")
  deviceType String?        @map("device_type")
  lastUsedAt DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([familyId])
  @@index([userId, isRevoked, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  impersonatorId String?       @map("impersonator_id") @db.Uuid
  action         String        @db.VarChar(100)
  outcome        AuditOutcome  @default(success)
  severity       AuditSeverity @default(info)
  projectId      String?       @map("project_id") @db.Uuid
  targetType     String?       @map("target_type") @db.VarChar(50)
  targetId       String?       @map("target_id") @db.VarChar(100)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent")
  traceId        String?       @map("trace_id") @db.VarChar(64)
  metadata       Json?         @default("{}")
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorId, occurredAt(sort: Desc)])
  @@index([projectId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([severity, occurredAt(sort: Desc)])
  @@index([ipAddress, action, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("audit_logs")
}

model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique @map("token_hash")
  type      VerificationTokenType @default(email_verification)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type])
  @@map("verification_tokens")
}
