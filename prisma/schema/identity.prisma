// -- 1. Identity Bounded Context (Identity Domain) ----------------------------

enum UserStatus {
  active
  suspended
  pending_verification
  deactivated
}

enum AuthProvider {
  google
  github
  orcid
  saml
  local
}

enum AuditOutcome {
  success
  failure
  denied
}

enum AuditSeverity {
  info
  warning
  error
  critical
}

enum VerificationTokenType {
  email_verification
  password_reset
}

enum ThemePreference {
  light
  dark
  system
}

model User {
  id        String     @id @default(uuid(7)) @db.Uuid
  email     String     @unique @db.VarChar(255)
  password  String?    @map("password_hash") @db.VarChar(255)
  status    UserStatus @default(pending_verification)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Personal Space (1:1)
  personalSpace Space? @relation("UserPersonalSpace")

  // Identity Internal Relations
  profile            UserProfile?
  settings           UserSettings?
  accounts           UserAccount[]
  integrations       UserIntegration[]
  gitAccessTokens    GitAccessToken[]    @relation("UserGitAccessTokens")
  gitPushEvents      GitPushEvent[]      @relation("UserGitPushEvents")
  pageTemplates      PageTemplate[]      @relation("UserPageTemplates")
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]          @relation("AuditActor")

  // Collaborative Project Relations
  createdProjects  Project[]         @relation("ProjectCreator")
  projectMembers   ProjectMember[]   @relation("UserProjectMemberships")
  projectFavorites ProjectFavorite[] @relation("UserProjectFavorites")
  projectUpdates   ProjectUpdate[]   @relation("UserProjectUpdates")

  // Files Relations
  createdFiles        FileNode[]    @relation("UserFileNodes")
  starredFiles        FileStar[]    @relation("UserStarredFiles")
  sharedFiles         FileShare[]   @relation("UserSharedFiles")
  createdFileVersions FileVersion[] @relation("UserFileVersions")
  fileUploads         FileUpload[]  @relation("UserFileUploads")

  // Work-Item & Space Label Relations
  userActivityEvents    ActivityEvent[]    @relation("UserActivityEvents")
  createdWorkItems      WorkItem[]         @relation("WorkItemCreator")
  assignedWorkItems     WorkItem[]         @relation("WorkItemAssignee")
  workItemComments      WorkItemComment[]
  userDrafts            WorkItemDraft[]    @relation("UserDrafts")
  userAttachments       EntityAttachment[] @relation("UserAttachments")
  createdSpaceLabels    SpaceLabel[]       @relation("UserCreatedLabels")
  workItemCoAssignments WorkItemAssignee[] @relation("WorkItemCoAssignees")

  // AI & Intelligence Relations
  aiChats AiChat[] @relation("UserAiChats")

  // Sticky Notes Relations
  stickies Sticky[] @relation("UserStickies")

  // Chat & Social Relations
  sentFriendRequests     Friendship[]         @relation("SentFriendRequests")
  receivedFriendRequests Friendship[]         @relation("ReceivedFriendRequests")
  createdConversations   Conversation[]       @relation("ConversationCreator")
  conversationMembers    ConversationMember[] @relation("UserConversationMembers")
  chatMessages           Message[]            @relation("UserChatMessages")
  messageReactions       MessageReaction[]    @relation("UserMessageReactions")

  @@index([status, deletedAt])
  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("User") @db.VarChar(100)
  firstName   String?  @map("first_name") @db.VarChar(100)
  lastName    String?  @map("last_name") @db.VarChar(100)
  avatar      String?  @map("avatar_url")
  coverImage  String?  @map("cover_image_url")
  institution String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@index([institution])
  @@map("user_profiles")
}

model UserSettings {
  userId        String          @id @map("user_id") @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         ThemePreference @default(system)
  locale        String          @default("en") @db.VarChar(10)
  timezone      String?         @default("UTC") @db.VarChar(50)
  editorConfig  Json            @default("{}") @map("editor_config") @db.JsonB
  preferences   Json            @default("{}") @db.JsonB
  notifications Json            @default("{}") @db.JsonB
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_settings")
}

model UserAccount {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id") @db.VarChar(255)
  email             String?      @db.VarChar(255)
  profileData       Json?        @map("profile_data") @db.JsonB
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerSubjectId])
  @@unique([userId, provider])
  @@index([email])
  @@map("user_accounts")
}

model RefreshToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique @map("token_hash") @db.VarChar(255)
  familyId   String         @default(uuid(7)) @map("family_id") @db.Uuid
  parentId   String?        @map("parent_id") @db.Uuid
  parent     RefreshToken?  @relation("TokenLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children   RefreshToken[] @relation("TokenLineage")
  isRevoked  Boolean        @default(false) @map("is_revoked")
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  userAgent  String?        @map("user_agent") @db.VarChar(512)
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  deviceType String?        @map("device_type") @db.VarChar(50)
  lastUsedAt DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([familyId])
  @@index([userId, isRevoked, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  impersonatorId String?       @map("impersonator_id") @db.Uuid
  action         String        @db.VarChar(100)
  outcome        AuditOutcome  @default(success)
  severity       AuditSeverity @default(info)
  projectId      String?       @map("project_id") @db.Uuid
  targetType     String?       @map("target_type") @db.VarChar(50)
  targetId       String?       @map("target_id") @db.VarChar(100)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent")
  traceId        String?       @map("trace_id") @db.VarChar(64)
  metadata       Json?         @default("{}") @db.JsonB
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorId, occurredAt(sort: Desc)])
  @@index([projectId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([severity, occurredAt(sort: Desc)])
  @@index([ipAddress, action, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("audit_logs")
}

model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique @map("token_hash") @db.VarChar(255)
  type      VerificationTokenType @default(email_verification)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type, expiresAt], map: "idx_verification_tokens_active")
  @@map("verification_tokens")
}
