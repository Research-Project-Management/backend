// -- 4. Work-Item & Issue Tracking Context (WorkItem Microservice) -----------

enum WorkItemPriority {
  urgent
  high
  medium
  low
  none
}

enum CycleStatus {
  planned
  active
  completed
  cancelled
}

enum ViewAccess {
  public
  private
}

enum LabelType {
  work_item
  page
}

enum WorkItemRelationType {
  blocks
  blocked_by
  relates_to
  duplicate_of
}

model WorkItemState {
  id          String     @id @default(uuid())
  projectId   String     @map("project_id") @db.Uuid
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String     @default("#94a3b8")
  icon        String?    @default("")
  group       String     @default("backlog") // backlog, unstarted, started, completed, cancelled
  sequence    Int        @default(0)
  isDefault   Boolean    @default(false) @map("is_default")
  description String?    @default("")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  workItems   WorkItem[]

  @@unique([projectId, name])
  @@index([projectId, group, sequence])
  @@map("work_item_states")
}

model Cycle {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  description       String?     @default("")
  startDate         DateTime?   @map("start_date") @db.Timestamptz(6)
  endDate           DateTime?   @map("end_date") @db.Timestamptz(6)
  status            CycleStatus @default(planned)
  milestones        Json?       @default("[]")
  deliverables      Json?       @default("[]")
  order             Int         @default(0)
  startedAt         DateTime?   @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?   @map("ended_at") @db.Timestamptz(6)
  statsAtCompletion Json?       @default("{\"totalWorkItems\":0,\"completedWorkItems\":0,\"completionPercentage\":0}") @map("stats_at_completion")
  projectId         String      @map("project_id") @db.Uuid
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId          String      @map("author_id") @db.Uuid
  author            User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  // Relations
  workItems         WorkItem[]

  @@index([projectId, status, deletedAt])
  @@index([projectId, order])
  @@index([deletedAt])
  @@map("cycles")
}

model WorkItem {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  content        String?           @default("")
  columnId       String            @map("column_id")
  state          WorkItemState?    @relation(fields: [columnId], references: [id], onDelete: Restrict)
  startDate      DateTime?         @map("start_date") @db.Timestamptz(6)
  dueDate        DateTime?         @map("due_date") @db.Timestamptz(6)
  labels         String[]          @default([])
  rank           Float             @default(0)
  priority       WorkItemPriority  @default(none)
  relations      Json?             @default("[]")
  identifier     String?           @map("identifier")
  sequenceNumber Int?              @map("sequence_number")
  timeSpent      Float?            @default(0) @map("time_spent")
  completed      Boolean           @default(false)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(6)
  projectId      String            @map("project_id") @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String            @map("author_id") @db.Uuid
  author         User              @relation("WorkItemAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assigneeId     String?           @map("assignee_id") @db.Uuid
  assignee       User?             @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeIds    Json              @default("[]") @map("assignee_ids")
  subscriberIds  Json              @default("[]") @map("subscriber_ids")
  cycleId        String?           @map("cycle_id") @db.Uuid
  cycle          Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  parentWorkItemId String?         @map("parent_work_item_id") @db.Uuid
  parentWorkItem WorkItem?         @relation("WorkItemHierarchy", fields: [parentWorkItemId], references: [id], onDelete: Cascade)
  childWorkItems WorkItem[]        @relation("WorkItemHierarchy")
  updates        Json              @default("[]")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  // Relations
  comments              WorkItemComment[]
  assignees             WorkItemAssignee[]
  labelAssignments      WorkItemLabelAssignment[]
  outgoingRelations     WorkItemRelation[]        @relation("SourceWorkItemRelations")
  incomingRelations     WorkItemRelation[]        @relation("TargetWorkItemRelations")
  entityLinks           WorkItemEntityLink[]

  @@index([projectId, columnId, rank])
  @@index([projectId, columnId, deletedAt, rank])
  @@index([projectId, parentWorkItemId, rank])
  @@index([projectId, completed, deletedAt])
  @@index([projectId, identifier])
  @@index([assigneeId, deletedAt])
  @@index([authorId])
  @@map("work_items")
}

model WorkItemComment {
  id          String    @id @default(uuid()) @db.Uuid
  workItemId  String    @map("work_item_id") @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId    String    @map("author_id") @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  isEdited    Boolean   @default(false) @map("is_edited")
  reactions   Json?     @default("[]")
  replies     Json?     @default("[]")
  attachments Json?     @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workItemId])
  @@index([workItemId, createdAt])
  @@index([authorId])
  @@map("work_item_comments")
}

model WorkItemDraft {
  id          String            @id @default(uuid()) @db.Uuid
  title       String            @default("")
  content     String?           @default("")
  description String?           @default("")
  columnId    String?           @map("column_id")
  priority    WorkItemPriority  @default(none)
  startDate   DateTime?         @map("start_date") @db.Timestamptz(6)
  dueDate     DateTime?         @map("due_date") @db.Timestamptz(6)
  labels      String[]          @default([])
  assigneeId  String?           @map("assignee_id") @db.Uuid
  assigneeIds Json              @default("[]") @map("assignee_ids")
  metadata    Json?             @default("{}")
  projectId   String?           @map("project_id") @db.Uuid
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String            @map("author_id") @db.Uuid
  author      User              @relation("UserDrafts", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authorId, createdAt])
  @@index([projectId, authorId])
  @@map("work_item_drafts")
}

model WorkItemTemplate {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String?           @default("")
  title       String?           @default("")
  content     String?           @default("")
  priority    WorkItemPriority  @default(none)
  labels      String[]          @default([])
  labelIds    Json              @default("[]") @map("label_ids")
  assigneeIds Json              @default("[]") @map("assignee_ids")
  checklists  Json              @default("[]")
  isDefault   Boolean           @default(false) @map("is_default")
  projectId   String            @map("project_id") @db.Uuid
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String            @map("author_id") @db.Uuid
  author      User              @relation("UserTemplates", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)

  @@index([projectId, isDefault])
  @@index([projectId, deletedAt])
  @@index([authorId])
  @@map("work_item_templates")
}

model WorkItemView {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  description       String?        @default("")
  query             Json           @default("{}")
  filters           Json?          @default("{}")
  displayFilters    Json?          @default("{}") @map("display_filters")
  displayProperties Json?          @default("{}") @map("display_properties")
  richFilters       Json?          @default("{}") @map("rich_filters")
  access            ViewAccess     @default(public)
  sortOrder         Float          @default(65535) @map("sort_order")
  logoProps         Json?          @default("{}") @map("logo_props")
  isLocked          Boolean        @default(false) @map("is_locked")
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  projectId         String         @map("project_id") @db.Uuid
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById       String         @map("created_by_id") @db.Uuid
  createdBy         User           @relation("ViewAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  favorites         ViewFavorite[]
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, access])
  @@index([projectId, createdById])
  @@map("work_item_views")
}

model ViewFavorite {
  id        String       @id @default(uuid()) @db.Uuid
  viewId    String       @map("view_id") @db.Uuid
  view      WorkItemView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([viewId, userId])
  @@index([userId])
  @@map("view_favorites")
}

model ProjectUserProperty {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters           Json      @default("{}")
  displayFilters    Json      @default("{}") @map("display_filters")
  displayProperties Json      @default("{}") @map("display_properties")
  richFilters       Json      @default("{}") @map("rich_filters")
  preferences       Json      @default("{}")
  sortOrder         Float     @default(65535) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_user_properties")
}

model EntityAttachment {
  id          String     @id @default(uuid()) @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id")
  projectId   String?    @map("project_id") @db.Uuid
  filename    String
  url         String
  storageKey  String?    @map("storage_key")
  size        Int        @default(0)
  mimeType    String     @default("application/octet-stream") @map("mime_type")
  metadata    Json?      @default("{}")
  authorId    String?    @map("author_id") @db.Uuid
  author      User?      @relation("UserAttachments", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt], map: "idx_entity_attachments_entity")
  @@index([projectId, createdAt], map: "idx_entity_attachments_project")
  @@index([authorId], map: "idx_entity_attachments_author")
  @@map("entity_attachments")
}

model WorkItemLabel {
  id                  String                    @id @default(uuid(7)) @db.Uuid
  name                String
  color               String                    @default("#3b82f6")
  description         String?
  sortOrder           Float                     @default(65535) @map("sort_order")
  parentId            String?                   @map("parent_id") @db.Uuid
  parent              WorkItemLabel?            @relation("WorkItemLabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            WorkItemLabel[]           @relation("WorkItemLabelHierarchy")
  projectId           String?                   @map("project_id") @db.Uuid
  project             Project?                  @relation("ProjectWorkItemLabels", fields: [projectId], references: [id], onDelete: Cascade)
  createdById         String                    @map("created_by_id") @db.Uuid
  createdBy           User                      @relation("UserCreatedWorkItemLabels", fields: [createdById], references: [id], onDelete: Cascade)
  workItemAssignments WorkItemLabelAssignment[] @relation("WorkItemLabelAssignments")
  pageAssignments     PageLabelAssignment[]     @relation("PageLabelAssignments")
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@index([projectId, sortOrder])
  @@index([projectId, parentId])
  @@index([createdById])
  @@map("work_item_labels")
}

model WorkItemAssignee {
  workItemId String   @map("work_item_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user       User     @relation("WorkItemCoAssignees", fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
  @@index([userId])
  @@map("work_item_assignees")
}

model WorkItemRelation {
  id             String               @id @default(uuid()) @db.Uuid
  sourceId       String               @map("source_id") @db.Uuid
  targetId       String               @map("target_id") @db.Uuid
  type           WorkItemRelationType
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceWorkItem WorkItem             @relation("SourceWorkItemRelations", fields: [sourceId], references: [id], onDelete: Cascade)
  targetWorkItem WorkItem             @relation("TargetWorkItemRelations", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
  @@map("work_item_relations")
}

model WorkItemLabelAssignment {
  workItemId String        @map("work_item_id") @db.Uuid
  labelId    String        @map("label_id") @db.Uuid
  assignedAt DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)

  workItem   WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label      WorkItemLabel @relation("WorkItemLabelAssignments", fields: [labelId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
  @@index([labelId])
  @@map("work_item_label_assignments")
}

model WorkItemEntityLink {
  id          String     @id @default(uuid()) @db.Uuid
  workItemId  String     @map("work_item_id") @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id") @db.Uuid
  description String?    @default("")
  metadata    Json?      @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  workItem    WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("work_item_entity_links")
}

