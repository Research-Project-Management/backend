// -- 4. Work-Item, Drafts & Unified Space Labels Context ---------------------

enum WorkItemPriority {
  urgent
  high
  medium
  low
  none
}

enum WorkItemRelationType {
  blocks
  blocked_by
  relates_to
  duplicate_of
}

model WorkItemState {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#94a3b8")
  icon        String?  @default("")
  group       String   @default("backlog") // backlog, unstarted, started, completed, cancelled
  sequence    Int      @default(0)
  isDefault   Boolean  @default(false) @map("is_default")
  description String?  @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workItems WorkItem[]

  @@unique([projectId, name])
  @@index([projectId, group, sequence])
  @@map("work_item_states")
}

model WorkItem {
  id               String           @id @default(uuid(7)) @db.Uuid
  title            String
  content          String?          @default("")
  stateId          String           @map("state_id") @db.Uuid
  state            WorkItemState    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  startDate        DateTime?        @map("start_date") @db.Timestamptz(6)
  dueDate          DateTime?        @map("due_date") @db.Timestamptz(6)
  rank             Float            @default(0)
  priority         WorkItemPriority @default(none)
  identifier       String?          @map("identifier")
  sequenceNumber   Int?             @map("sequence_number")
  timeSpent        Float?           @default(0) @map("time_spent")
  completed        Boolean          @default(false)
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(6)
  projectId        String           @map("project_id") @db.Uuid
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById      String           @map("created_by_id") @db.Uuid
  createdBy        User             @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assigneeId       String?          @map("assignee_id") @db.Uuid
  assignee         User?            @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subscriberIds    Json             @default("[]") @map("subscriber_ids")
  parentWorkItemId String?          @map("parent_work_item_id") @db.Uuid
  parentWorkItem   WorkItem?        @relation("WorkItemHierarchy", fields: [parentWorkItemId], references: [id], onDelete: Cascade)
  childWorkItems   WorkItem[]       @relation("WorkItemHierarchy")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  comments          WorkItemComment[]
  assignees         WorkItemAssignee[]
  labelAssignments  WorkItemLabelAssignment[]
  outgoingRelations WorkItemRelation[]        @relation("SourceWorkItemRelations")
  incomingRelations WorkItemRelation[]        @relation("TargetWorkItemRelations")
  entityLinks       WorkItemEntityLink[]

  @@index([projectId, stateId, rank])
  @@index([projectId, stateId, deletedAt, rank])
  @@index([projectId, deletedAt, archivedAt, rank])
  @@index([projectId, deletedAt, updatedAt(sort: Desc)])
  @@index([projectId, deletedAt, dueDate])
  @@index([projectId, parentWorkItemId, rank])
  @@index([projectId, completed, deletedAt])
  @@index([projectId, identifier])
  @@index([assigneeId, deletedAt])
  @@index([assigneeId, deletedAt, archivedAt, updatedAt(sort: Desc)])
  @@index([createdById])
  @@index([createdById, deletedAt, updatedAt(sort: Desc)])
  @@map("work_items")
}

model WorkItemComment {
  id          String   @id @default(uuid(7)) @db.Uuid
  workItemId  String   @map("work_item_id") @db.Uuid
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  content     String
  isEdited    Boolean  @default(false) @map("is_edited")
  reactions   Json?    @default("[]")
  replies     Json?    @default("[]")
  attachments Json?    @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workItemId, createdAt])
  @@index([createdById])
  @@map("work_item_comments")
}

model WorkItemDraft {
  id          String           @id @default(uuid(7)) @db.Uuid
  spaceId     String           @map("space_id") @db.Uuid
  space       Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById String           @map("created_by_id") @db.Uuid
  createdBy   User             @relation("UserDrafts", fields: [createdById], references: [id], onDelete: Cascade)
  title       String           @default("")
  content     String           @default("")
  stateId     String?          @map("state_id") @db.Uuid
  priority    WorkItemPriority @default(none)
  startDate   DateTime?        @map("start_date") @db.Timestamptz(6)
  dueDate     DateTime?        @map("due_date") @db.Timestamptz(6)
  labels      String[]         @default([])
  assigneeId  String?          @map("assignee_id") @db.Uuid
  assigneeIds Json             @default("[]") @map("assignee_ids")
  metadata    Json?            @default("{}") @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId, updatedAt(sort: Desc)])
  @@index([createdById, createdAt])
  @@map("work_item_drafts")
}

model EntityAttachment {
  id          String     @id @default(uuid(7)) @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id")
  spaceId     String?    @map("space_id") @db.Uuid
  filename    String
  url         String
  storageKey  String?    @map("storage_key")
  size        Int        @default(0)
  mimeType    String     @default("application/octet-stream") @map("mime_type")
  metadata    Json?      @default("{}") @db.JsonB
  createdById String?    @map("created_by_id") @db.Uuid
  createdBy   User?      @relation("UserAttachments", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt], map: "idx_entity_attachments_entity")
  @@index([spaceId, createdAt], map: "idx_entity_attachments_space")
  @@index([createdById], map: "idx_entity_attachments_creator")
  @@map("entity_attachments")
}

model SpaceLabel {
  id                  String                    @id @default(uuid(7)) @db.Uuid
  spaceId             String                    @map("space_id") @db.Uuid
  space               Space                     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById         String                    @map("created_by_id") @db.Uuid
  createdBy           User                      @relation("UserCreatedLabels", fields: [createdById], references: [id], onDelete: Cascade)
  name                String                    @db.VarChar(100)
  color               String                    @default("#3b82f6") @db.VarChar(30)
  description         String?                   @db.VarChar(500)
  sortOrder           Float                     @default(65535) @map("sort_order")
  parentId            String?                   @map("parent_id") @db.Uuid
  parent              SpaceLabel?               @relation("SpaceLabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            SpaceLabel[]              @relation("SpaceLabelHierarchy")
  workItemAssignments WorkItemLabelAssignment[] @relation("WorkItemLabelAssignments")
  projectAssignments  ProjectLabel[]
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([spaceId, parentId, name], map: "uq_space_labels_space_parent_name")
  @@index([spaceId, sortOrder])
  @@index([spaceId, parentId])
  @@index([createdById])
  @@map("space_labels")
}

model WorkItemAssignee {
  workItemId String   @map("work_item_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation("WorkItemCoAssignees", fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
  @@index([userId])
  @@map("work_item_assignees")
}

model WorkItemRelation {
  id        String               @id @default(uuid(7)) @db.Uuid
  sourceId  String               @map("source_id") @db.Uuid
  targetId  String               @map("target_id") @db.Uuid
  type      WorkItemRelationType
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceWorkItem WorkItem @relation("SourceWorkItemRelations", fields: [sourceId], references: [id], onDelete: Cascade)
  targetWorkItem WorkItem @relation("TargetWorkItemRelations", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
  @@map("work_item_relations")
}

model WorkItemLabelAssignment {
  workItemId String   @map("work_item_id") @db.Uuid
  labelId    String   @map("label_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  workItem WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label    SpaceLabel @relation("WorkItemLabelAssignments", fields: [labelId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
  @@index([labelId])
  @@map("work_item_label_assignments")
}

model WorkItemEntityLink {
  id          String     @id @default(uuid(7)) @db.Uuid
  workItemId  String     @map("work_item_id") @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id") @db.Uuid
  description String?    @default("")
  metadata    Json?      @default("{}") @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("work_item_entity_links")
}
