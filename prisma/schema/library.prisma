// -- 7. Academic Library & Research Context (Library Microservice) -----------

enum RagStatus {
  pending
  indexed
  failed
}

enum AttachmentType {
  primary_pdf
  supplementary
  dataset
  slides
  code
  figure
  other
  preview
}

enum AnnotationType {
  highlight
  underline
  strike
  note
  rect
  text
  image
}

enum RelationType {
  cites
  cited_by
  replicates
  extends
  is_preprint_of
  is_published_version_of
  is_translation_of
  supplements
  related
  rebuts
  uses_dataset
  survey_of
}

enum IngestionStatus {
  RECEIVED
  DETECTED
  EXTRACTED
  RESOLVED
  NORMALIZED
  MERGED
  NEEDS_REVIEW
  COMMITTED
  ENRICHING
  READY
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum AttachmentExtractionStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  FAILED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum ReadStatus {
  unread
  reading
  completed
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model Item {
  id                  String      @id @default(uuid()) @db.Uuid
  title               String
  year                Int?
  doi                 String?
  abstract            String?
  itemType            String?     @default("journalArticle") @map("item_type")
  publicationTitle    String?     @map("publication_title")
  publicationDate     String?     @map("publication_date")
  publisher           String?
  place               String?
  volume              String?
  issue               String?
  section             String?
  partNumber          String?     @map("part_number")
  partTitle           String?     @map("part_title")
  pages               String?
  series              String?
  seriesTitle         String?     @map("series_title")
  seriesText          String?     @map("series_text")
  issn                String?
  isbn                String?
  pmid                String?
  pmcid               String?
  url                 String?
  language            String?
  journalAbbr         String?     @map("journal_abbr")
  shortTitle          String?     @map("short_title")
  rights              String?
  license             String?
  citationKey         String?     @map("citation_key")
  libraryCatalog      String?     @map("library_catalog")
  archive             String?
  archiveLocation     String?     @map("archive_location")
  callNumber          String?     @map("call_number")
  accessedAt          DateTime?   @map("accessed_at") @db.Timestamptz(6)
  extra               String?     @default("")
  arxivId             String?     @map("arxiv_id")
  citationCount       Int?        @map("citation_count")
  referenceCount      Int?        @map("reference_count")
  openAccessPdfUrl    String?     @map("open_access_pdf_url")
  seriesNumber        String?     @map("series_number")
  ragDocId            String?     @map("rag_doc_id")
  ragIndexedAt        DateTime?   @map("rag_indexed_at") @db.Timestamptz(6)
  ragLastAttemptAt    DateTime?   @map("rag_last_attempt_at") @db.Timestamptz(6)
  ragAttempts         Int         @default(0) @map("rag_attempts")
  ragError            String?     @map("rag_error")
  ragStatus           RagStatus?  @map("rag_status")
  isRetracted         Boolean     @default(false) @map("is_retracted")
  retractionNature    String?     @map("retraction_nature")
  retractionDetails   Json?       @map("retraction_details")
  retractionCheckedAt DateTime?   @map("retraction_checked_at") @db.Timestamptz(6)
  isMyPublication     Boolean     @default(false) @map("is_my_publication")
  publicationConfirmedAt DateTime? @map("publication_confirmed_at") @db.Timestamptz(6)
  userId              String      @map("user_id") @db.Uuid
  user                User        @relation("UserItems", fields: [userId], references: [id], onDelete: Cascade)
  uploadedById        String?     @default("system") @map("uploaded_by_id")
  projectId           String?     @map("project_id") @db.Uuid
  project             Project?    @relation("ProjectItems", fields: [projectId], references: [id], onDelete: Cascade)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Canonical Relations
  attachments         Attachment[]
  contributors        Contributor[]
  identifiers         Identifier[]
  collectionItems     CollectionItem[]
  itemTags            ItemTag[]
  revisions           ItemRevision[]
  notesList           Note[]
  outgoingRel         ItemRelation[]         @relation("SourceItem")
  incomingRel         ItemRelation[]         @relation("TargetItem")
  states              State[]
  ingestionRuns       IngestionRun[]
  sourceRecords       MetadataSourceRecord[]

  @@index([userId, deletedAt])
  @@index([projectId, deletedAt])
  @@index([userId, deletedAt, year(sort: Desc), createdAt(sort: Desc)])
  @@index([userId, itemType])
  @@index([doi])
  @@index([citationKey])
  @@index([arxivId])
  @@map("papers")
}

model Contributor {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creatorType String   @default("author") @map("creator_type")
  firstName   String?  @default("") @map("first_name")
  lastName    String?  @default("") @map("last_name")
  fullName    String   @map("full_name")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, orderIndex])
  @@index([fullName])
  @@map("contributors")
}

model Identifier {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type         String
  value        String
  canonicalUri String?  @map("canonical_uri")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([itemId, type, value])
  @@index([type, value])
  @@map("identifiers")
}

model Collection {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String?      @default("")
  color       String?
  icon        String?      @default("")
  createdById String?      @map("created_by_id")
  parentId    String?      @map("parent_id") @db.Uuid
  parent      Collection?  @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Collection[] @relation("CollectionHierarchy")
  userId      String       @map("user_id") @db.Uuid
  user      User         @relation("UserCollections", fields: [userId], references: [id], onDelete: Cascade)
  projectId String?      @map("project_id") @db.Uuid
  project   Project?     @relation("ProjectCollections", fields: [projectId], references: [id], onDelete: Cascade)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  collectionItems CollectionItem[]

  @@index([userId, parentId, createdAt])
  @@index([projectId, parentId, createdAt])
  @@map("collections")
}

model CollectionItem {
  id           String     @id @default(uuid()) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  itemId       String     @map("item_id") @db.Uuid
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0) @map("sort_order")
  addedAt      DateTime   @default(now()) @map("added_at") @db.Timestamptz(6)

  @@unique([collectionId, itemId])
  @@index([itemId])
  @@map("collection_items")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  color     String?
  type      String?   @default("manual")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation("UserTags", fields: [userId], references: [id], onDelete: Cascade)
  projectId String?   @map("project_id") @db.Uuid
  project   Project?  @relation("ProjectTags", fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  itemTags  ItemTag[]

  @@unique([userId, name])
  @@index([userId])
  @@index([projectId])
  @@map("tags")
}

model ItemTag {
  id         String   @id @default(uuid()) @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id") @db.Uuid
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@unique([tagId, itemId])
  @@index([itemId])
  @@map("item_tags")
}

model Attachment {
  id                 String                     @id @default(uuid()) @db.Uuid
  itemId             String                     @map("item_id") @db.Uuid
  item               Item                       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type               AttachmentType             @default(primary_pdf)
  attachmentType     AttachmentType             @default(primary_pdf) @map("attachment_type")
  name               String                     @default("document.pdf")
  filename           String                     @default("document.pdf")
  url                String                     @default("")
  fileHash           String?                    @default("") @map("file_hash")
  fileId             String?                    @map("file_id") @db.Uuid
  file               File?                      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  storageKey         String?                    @map("storage_key")
  mimeType           String                     @default("application/pdf") @map("mime_type")
  size               Int                        @default(0)
  extractedText      String?                    @map("extracted_text")
  extractionStatus   AttachmentExtractionStatus @default(PENDING) @map("extraction_status")
  extractionAttempts Int                        @default(0) @map("extraction_attempts")
  extractionStartedAt DateTime?                 @map("extraction_started_at") @db.Timestamptz(6)
  extractionCompletedAt DateTime?               @map("extraction_completed_at") @db.Timestamptz(6)
  extractionLastError String?                   @map("extraction_last_error")
  metadata           Json?                      @default("{}")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                  @map("deleted_at") @db.Timestamptz(6)

  revisions          AttachmentRevision[]
  annotations        Annotation[]
  fullTextIndexes    FullTextIndex[]

  @@index([itemId, type])
  @@index([fileId])
  @@map("attachments")
}

model AttachmentRevision {
  id             String     @id @default(uuid()) @db.Uuid
  attachmentId   String     @map("attachment_id") @db.Uuid
  attachment     Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  revisionNumber Int        @default(1) @map("revision_number")
  fileHash       String?    @default("") @map("file_hash")
  sizeBytes      Int        @default(0) @map("size_bytes")
  url            String     @default("")
  comment        String?    @default("")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attachmentId, revisionNumber])
  @@map("attachment_revisions")
}

model Annotation {
  id                  String         @id @default(uuid()) @db.Uuid
  attachmentId        String         @map("attachment_id") @db.Uuid
  attachment          Attachment     @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  type                AnnotationType @default(highlight)
  color               String         @default("#ffeb3b")
  pageIndex           Int            @default(0) @map("page_index")
  annotationSortIndex String         @default("") @map("annotation_sort_index")
  rectCoords          Json?          @map("rect_coords")
  quoteText           String?        @map("quote_text")
  comment             String?        @default("")
  tags                String[]       @default([])
  authorId            String         @map("author_id") @db.Uuid
  author              User           @relation("UserAnnotations", fields: [authorId], references: [id], onDelete: Cascade)
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)

  @@index([attachmentId, pageIndex])
  @@index([authorId])
  @@map("annotations")
}

model FullTextIndex {
  id           String     @id @default(uuid()) @db.Uuid
  attachmentId String     @map("attachment_id") @db.Uuid
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  pageIndex    Int        @map("page_index")
  textContent  String     @map("text_content")
  charOffset   Int        @default(0) @map("char_offset")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([attachmentId, pageIndex])
  @@map("full_text_indexes")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  item        Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title       String    @default("Untitled Note")
  contentMd   String    @default("") @map("content_md")
  contentJson Json?     @map("content_json")
  tags        String[]  @default([])
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?   @map("created_by_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  project     Project?  @relation("ProjectNotes", fields: [projectId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([itemId])
  @@index([userId])
  @@index([projectId])
  @@map("notes")
}

model ItemRelation {
  id           String       @id @default(uuid()) @db.Uuid
  sourceItemId String       @map("source_item_id") @db.Uuid
  sourceItem   Item         @relation("SourceItem", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItemId String       @map("target_item_id") @db.Uuid
  targetItem   Item         @relation("TargetItem", fields: [targetItemId], references: [id], onDelete: Cascade)
  relationType RelationType @default(related) @map("relation_type")
  description  String?      @default("")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceItemId, targetItemId, relationType])
  @@index([targetItemId])
  @@map("item_relations")
}

model State {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  user           User       @relation("UserItemStates", fields: [userId], references: [id], onDelete: Cascade)
  itemId         String     @map("item_id") @db.Uuid
  item           Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  readStatus     ReadStatus @default(unread) @map("read_status")
  rating         Int?
  currentPage    Int?       @map("current_page")
  scrollPosition Json?      @map("scroll_position")
  lastOpenedAt   DateTime?  @map("last_opened_at") @db.Timestamptz(6)
  lastReadAt     DateTime?  @map("last_read_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, itemId])
  @@index([userId, readStatus])
  @@map("user_item_states")
}

model SavedSearch {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  query           String?   @default("")
  description     String?   @default("")
  filters         Json?     @default("{}")
  conditions      Json?     @default("{}")
  conjunction     String?   @default("AND")
  sortBy          String?   @default("dateAdded") @map("sort_by")
  sortOrder       String?   @default("desc") @map("sort_order")
  isPinned        Boolean   @default(false) @map("is_pinned")
  icon            String?   @default("")
  color           String?
  cachedCount     Int       @default(0) @map("cached_count")
  lastEvaluatedAt DateTime? @map("last_evaluated_at") @db.Timestamptz(6)
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation("UserSavedSearches", fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?   @map("project_id") @db.Uuid
  project         Project?  @relation("ProjectSavedSearches", fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([projectId])
  @@map("saved_searches")
}

model RetractionRecord {
  id               String    @id @default(uuid()) @db.Uuid
  doi              String    @unique
  pmid             String?
  isRetracted      Boolean   @default(true) @map("is_retracted")
  retractionDate   DateTime? @map("retraction_date") @db.Timestamptz(6)
  nature           String?
  noticeUrl        String?   @map("notice_url")
  reason           String?
  source           String    @default("crossref")
  rawMetadata      Json?     @map("raw_metadata")
  checkedAt        DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([doi])
  @@index([pmid])
  @@map("retraction_records")
}

model MetadataSourceRecord {
  id             String   @id @default(uuid()) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source         String?  @default("")
  sourceProvider String   @default("arxiv") @map("source_provider")
  rawJson        Json?    @map("raw_json")
  rawPayload     Json?    @map("raw_payload")
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, sourceProvider])
  @@map("metadata_source_records")
}

model ItemRevision {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  changeLog String?  @map("change_log")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([itemId, version])
  @@map("item_revisions")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation("UserIdempotencyRecords", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?   @map("project_id") @db.Uuid
  project        Project?  @relation("ProjectIdempotencyRecords", fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey String    @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body")
  status         String    @default("in_progress")
  response       Json?
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, idempotencyKey])
  @@index([projectId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model SyncSequence {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid
  user            User?    @relation("UserSyncSequence", fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?  @unique @map("project_id") @db.Uuid
  project         Project? @relation("ProjectSyncSequence", fields: [projectId], references: [id], onDelete: Cascade)
  currentSequence BigInt   @default(0) @map("current_sequence")

  @@map("sync_sequences")
}

model LibraryChange {
  id          String   @id @default(uuid()) @db.Uuid
  seq         BigInt
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation("UserLibraryChanges", fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?  @map("project_id") @db.Uuid
  project     Project? @relation("ProjectLibraryChanges", fields: [projectId], references: [id], onDelete: Cascade)
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  version     Int
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, seq])
  @@index([projectId, seq])
  @@map("library_changes")
}

model Tombstone {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  user        User?     @relation("UserTombstones", fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?   @map("project_id") @db.Uuid
  project     Project?  @relation("ProjectTombstones", fields: [projectId], references: [id], onDelete: Cascade)
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  seq         BigInt
  deletedById String?   @map("deleted_by_id") @db.Uuid
  deletedBy   User?     @relation("TombstoneDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime  @default(now()) @map("deleted_at") @db.Timestamptz(6)

  @@index([userId, entityType, entityId])
  @@index([projectId, entityType, entityId])
  @@map("tombstones")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation("UserOutboxEvents", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?      @map("project_id") @db.Uuid
  project        Project?     @relation("ProjectOutboxEvents", fields: [projectId], references: [id], onDelete: Cascade)
  aggregateId    String       @map("aggregate_id")
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  error          String?
  scheduledAt    DateTime?    @map("scheduled_at") @db.Timestamptz(6)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  claimedBy      String?      @map("claimed_by")
  dedupeKey      String?      @map("dedupe_key")
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("outbox_events")
}

model IngestionRun {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  user            User                 @relation("UserIngestionRuns", fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?              @map("project_id") @db.Uuid
  project         Project?             @relation("ProjectIngestionRuns", fields: [projectId], references: [id], onDelete: Cascade)
  requesterId     String?              @map("requester_id")
  inputParams     Json                 @map("input_params")
  inputHash       String               @map("input_hash")
  idempotencyKey  String?              @map("idempotency_key")
  contractVersion String               @default("1.0.0") @map("contract_version")
  pipelineVersion String               @default("1.0.0") @map("pipeline_version")
  status          IngestionStatus      @default(RECEIVED)
  attempts        Int                  @default(0)
  maxRetries      Int                  @default(3) @map("max_retries")
  itemId          String?              @map("item_id") @db.Uuid
  item            Item?                @relation(fields: [itemId], references: [id], onDelete: SetNull)
  lastError       String?              @map("last_error")
  executionLog    Json?                @map("execution_log")
  startedAt       DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)

  stages          IngestionStage[]
  candidates      IngestionCandidate[]
  decisions       IngestionDecision[]
  reviewCases     IngestionReviewCase[]

  @@index([userId, status])
  @@index([projectId, status])
  @@map("ingestion_runs")
}

model IngestionStage {
  id             String       @id @default(uuid()) @db.Uuid
  ingestionRunId String       @map("ingestion_run_id") @db.Uuid
  ingestionRun   IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  stageName      String       @map("stage_name")
  durationMs     Int          @default(0) @map("duration_ms")
  success        Boolean      @default(true)
  errorMessage   String?      @map("error_message")
  outputSnapshot Json?        @map("output_snapshot")
  leaseToken     String?      @map("lease_token")
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  executedAt     DateTime     @default(now()) @map("executed_at") @db.Timestamptz(6)

  @@map("ingestion_stages")
}

model IngestionCandidate {
  id              String       @id @default(uuid()) @db.Uuid
  ingestionRunId  String       @map("ingestion_run_id") @db.Uuid
  ingestionRun    IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  sourceProvider  String       @map("source_provider")
  sourceRecordId  String?      @map("source_record_id")
  confidenceScore Float        @default(1.0) @map("confidence_score")
  metadataPayload Json         @map("metadata_payload")
  rawEvidenceRef  String?      @map("raw_evidence_ref")
  fetchedAt       DateTime     @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("ingestion_candidates")
}

model IngestionDecision {
  id             String       @id @default(uuid()) @db.Uuid
  ingestionRunId String       @map("ingestion_run_id") @db.Uuid
  ingestionRun   IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  decisionType   String       @map("decision_type")
  decisionReason String       @map("decision_reason")
  proposedItem   Json         @map("proposed_item")
  fieldDecisions Json?        @map("field_decisions")
  duplicateMatch Json?        @map("duplicate_match")
  decidedAt      DateTime     @default(now()) @map("decided_at") @db.Timestamptz(6)

  @@map("ingestion_decisions")
}

model IngestionReviewCase {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  user           User?        @relation("UserIngestionReviewCases", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?      @map("project_id") @db.Uuid
  project        Project?     @relation("ProjectIngestionReviewCases", fields: [projectId], references: [id], onDelete: Cascade)
  ingestionRunId String       @map("ingestion_run_id") @db.Uuid
  ingestionRun   IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  targetItemId   String?      @map("target_item_id") @db.Uuid
  reason         String
  evidence       Json?        @map("evidence")
  options        Json?        @map("options")
  assignedToId   String?      @map("assigned_to_id")
  status         String       @default("PENDING")
  resolution     String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)

  @@map("ingestion_review_cases")
}


model CapturePreview {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl         String    @map("source_url")
  canonicalMetadata Json      @map("canonical_metadata")
  metadataDigest    String    @map("metadata_digest")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@index([tokenHash])
  @@map("capture_previews")
}
