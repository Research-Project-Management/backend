// -- 7. Academic Library & Research Context (Library Microservice) -----------

enum RagStatus {
  pending
  indexed
  failed
}

enum AttachmentType {
  primary_pdf
  supplementary
  dataset
  slides
  code
  figure
  other
  preview
}

enum AnnotationType {
  highlight
  underline
  strike
  note
  rect
  text
  image
}

enum RelationType {
  cites
  cited_by
  replicates
  extends
  is_preprint_of
  is_published_version_of
  is_translation_of
  supplements
  related
  rebuts
  uses_dataset
  survey_of
}

enum IngestionStatus {
  RECEIVED
  DETECTED
  EXTRACTED
  RESOLVED
  NORMALIZED
  MERGED
  NEEDS_REVIEW
  COMMITTED
  ENRICHING
  READY
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum AttachmentExtractionStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  FAILED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum ReadStatus {
  unread
  reading
  completed
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum TagType {
  manual
  automatic
  ai
}

model Item {
  id                  String      @id @default(uuid(7)) @db.Uuid
  title               String
  type                String      @default("journalArticle")
  year                Int?
  citationKey         String?     @map("citation_key")
  doi                 String?
  publicationTitle    String?     @map("publication_title")
  abstract            String?
  url                 String?
  metadata            Json        @default("{}") @db.JsonB
  userId              String      @map("user_id") @db.Uuid
  projectId           String?     @map("project_id") @db.Uuid
  version             Int         @default(1)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Canonical Relations
  attachments         Attachment[]
  contributors        Contributor[]
  collectionItems     CollectionItem[]
  itemTags            ItemTag[]
  notesList           Note[]
  outgoingRel         ItemRelation[]         @relation("SourceItem")
  incomingRel         ItemRelation[]         @relation("TargetItem")
  states              State[]
  ingestionRuns       IngestionRun[]
  sourceRecords       MetadataSourceRecord[]

  @@index([userId, deletedAt])
  @@index([projectId, deletedAt])
  @@index([userId, deletedAt, year(sort: Desc), createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([doi])
  @@index([citationKey])
  @@index([publicationTitle])
  @@map("items")
}

model Contributor {
  id          String   @id @default(uuid(7)) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creatorType String   @default("author") @map("creator_type")
  firstName   String?  @default("") @map("first_name")
  lastName    String?  @default("") @map("last_name")
  fullName    String   @map("full_name")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, orderIndex])
  @@index([fullName])
  @@map("contributors")
}

model Collection {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  description String?      @default("")
  color       String?
  icon        String?      @default("")
  createdById String?      @map("created_by_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  parent      Collection?  @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Collection[] @relation("CollectionHierarchy")
  userId      String       @map("user_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  collectionItems CollectionItem[]

  @@index([userId, parentId, deletedAt])
  @@index([projectId, parentId, deletedAt])
  @@map("collections")
}

model CollectionItem {
  collectionId String     @map("collection_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  itemId       String     @map("item_id") @db.Uuid
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0) @map("sort_order")
  addedAt      DateTime   @default(now()) @map("added_at") @db.Timestamptz(6)

  @@id([collectionId, itemId])
  @@index([itemId])
  @@map("collection_items")
}

model Tag {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  color       String?   @default("#3b82f6")
  type        TagType   @default(manual)
  userId      String    @map("user_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  itemTags    ItemTag[]

  @@unique([userId, name, projectId])
  @@index([userId])
  @@index([projectId, name])
  @@map("tags")
}

model ItemTag {
  tagId      String   @map("tag_id") @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id") @db.Uuid
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([tagId, itemId])
  @@index([itemId])
  @@map("item_tags")
}

model Attachment {
  id                    String                     @id @default(uuid(7)) @db.Uuid
  itemId                String                     @map("item_id") @db.Uuid
  item                  Item                       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attachmentType        AttachmentType             @default(primary_pdf) @map("attachment_type")
  filename              String                     @default("document.pdf")
  url                   String                     @default("")
  fileHash              String?                    @default("") @map("file_hash")
  fileId                String?                    @map("file_id") @db.Uuid
  storageKey            String?                    @map("storage_key")
  mimeType              String                     @default("application/pdf") @map("mime_type")
  size                  BigInt                     @default(0)
  extractionStatus      AttachmentExtractionStatus @default(PENDING) @map("extraction_status")
  extractionAttempts    Int                        @default(0) @map("extraction_attempts")
  extractionStartedAt   DateTime?                  @map("extraction_started_at") @db.Timestamptz(6)
  extractionCompletedAt DateTime?                  @map("extraction_completed_at") @db.Timestamptz(6)
  extractionLastError   String?                    @map("extraction_last_error")
  metadata              Json?                      @default("{}")
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                  @map("deleted_at") @db.Timestamptz(6)

  revisions             AttachmentRevision[]
  annotations           Annotation[]
  fullTextIndexes       FullTextIndex[]

  @@index([itemId, attachmentType])
  @@index([fileId])
  @@index([extractionStatus, extractionStartedAt])
  @@map("attachments")
}

model AttachmentRevision {
  id             String     @id @default(uuid(7)) @db.Uuid
  attachmentId   String     @map("attachment_id") @db.Uuid
  attachment     Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  revisionNumber Int        @default(1) @map("revision_number")
  fileId         String?    @map("file_id") @db.Uuid
  fileHash       String?    @default("") @map("file_hash")
  sizeBytes      BigInt     @default(0) @map("size_bytes")
  url            String     @default("")
  comment        String?    @default("")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attachmentId, revisionNumber])
  @@index([fileId])
  @@map("attachment_revisions")
}

model Annotation {
  id                  String         @id @default(uuid(7)) @db.Uuid
  attachmentId        String         @map("attachment_id") @db.Uuid
  attachment          Attachment     @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  type                AnnotationType @default(highlight)
  color               String         @default("#ffeb3b")
  pageIndex           Int            @default(0) @map("page_index")
  annotationSortIndex String         @default("") @map("annotation_sort_index")
  rectCoords          Json?          @map("rect_coords")
  quoteText           String?        @map("quote_text")
  comment             String?        @default("")
  tags                String[]       @default([])
  authorId            String         @map("author_id") @db.Uuid
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)

  @@index([attachmentId, deletedAt, pageIndex])
  @@index([authorId, deletedAt])
  @@map("annotations")
}

model FullTextIndex {
  attachmentId String     @map("attachment_id") @db.Uuid
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  pageIndex    Int        @map("page_index")
  textContent  String     @map("text_content")
  charOffset   Int        @default(0) @map("char_offset")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([attachmentId, pageIndex])
  @@map("full_text_indexes")
}

model Note {
  id          String    @id @default(uuid(7)) @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  item        Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title       String    @default("Untitled Note")
  contentMd   String    @default("") @map("content_md")
  contentJson Json?     @map("content_json")
  tags        String[]  @default([])
  userId      String    @map("user_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([itemId, deletedAt])
  @@index([userId, deletedAt])
  @@index([projectId, deletedAt])
  @@map("notes")
}

model ItemRelation {
  id           String       @id @default(uuid(7)) @db.Uuid
  sourceItemId String       @map("source_item_id") @db.Uuid
  sourceItem   Item         @relation("SourceItem", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItemId String       @map("target_item_id") @db.Uuid
  targetItem   Item         @relation("TargetItem", fields: [targetItemId], references: [id], onDelete: Cascade)
  relationType RelationType @default(related) @map("relation_type")
  description  String?      @default("")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceItemId, targetItemId, relationType])
  @@index([targetItemId])
  @@map("item_relations")
}

model State {
  userId         String     @map("user_id") @db.Uuid
  itemId         String     @map("item_id") @db.Uuid
  item           Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  readStatus     ReadStatus @default(unread) @map("read_status")
  rating         Int?
  currentPage    Int?       @map("current_page")
  scrollPosition Json?      @map("scroll_position")
  lastOpenedAt   DateTime?  @map("last_opened_at") @db.Timestamptz(6)
  lastReadAt     DateTime?  @map("last_read_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([userId, itemId])
  @@index([userId, readStatus])
  @@index([itemId])
  @@map("user_item_states")
}

model SavedSearch {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  query           String?   @default("")
  description     String?   @default("")
  conditions      Json      @default("{}") @db.JsonB
  conjunction     String?   @default("AND")
  sortBy          String?   @default("dateAdded") @map("sort_by")
  sortOrder       String?   @default("desc") @map("sort_order")
  isPinned        Boolean   @default(false) @map("is_pinned")
  icon            String?   @default("")
  color           String?
  cachedCount     Int       @default(0) @map("cached_count")
  lastEvaluatedAt DateTime? @map("last_evaluated_at") @db.Timestamptz(6)
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  userId          String    @map("user_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, deletedAt])
  @@index([projectId, deletedAt])
  @@map("saved_searches")
}

model RetractionRecord {
  id               String    @id @default(uuid(7)) @db.Uuid
  doi              String    @unique
  pmid             String?
  isRetracted      Boolean   @default(true) @map("is_retracted")
  retractionDate   DateTime? @map("retraction_date") @db.Timestamptz(6)
  nature           String?
  noticeUrl        String?   @map("notice_url")
  reason           String?
  source           String    @default("crossref")
  rawMetadata      Json?     @map("raw_metadata") @db.JsonB
  checkedAt        DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([pmid])
  @@map("retraction_records")
}

model MetadataSourceRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source         String?  @default("")
  sourceProvider String   @default("arxiv") @map("source_provider")
  rawPayload     Json     @map("raw_payload") @db.JsonB
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, sourceProvider, createdAt(sort: Desc)])
  @@map("metadata_source_records")
}

model IdempotencyRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body") @db.JsonB
  status         String    @default("in_progress")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, idempotencyKey])
  @@index([projectId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model SyncSequence {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid
  projectId       String?  @unique @map("project_id") @db.Uuid
  currentSequence BigInt   @default(0) @map("current_sequence")

  @@map("sync_sequences")
}

model LibraryChange {
  id          String   @id @default(uuid(7)) @db.Uuid
  seq         BigInt
  userId      String?  @map("user_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  version     Int
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, seq])
  @@index([projectId, seq])
  @@map("library_changes")
}

model Tombstone {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  seq         BigInt
  deletedById String?   @map("deleted_by_id") @db.Uuid
  deletedAt   DateTime  @default(now()) @map("deleted_at") @db.Timestamptz(6)

  @@index([userId, seq])
  @@index([projectId, seq])
  @@index([userId, entityType, entityId])
  @@index([projectId, entityType, entityId])
  @@map("tombstones")
}

model OutboxEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  projectId      String?      @map("project_id") @db.Uuid
  aggregateId    String       @map("aggregate_id")
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  error          String?
  scheduledAt    DateTime?    @map("scheduled_at") @db.Timestamptz(6)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  claimedBy      String?      @map("claimed_by")
  dedupeKey      String?      @map("dedupe_key")
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([status, scheduledAt, leaseExpiresAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("outbox_events")
}

model IngestionRun {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  projectId       String?         @map("project_id") @db.Uuid
  inputParams     Json            @map("input_params")
  inputHash       String          @map("input_hash")
  idempotencyKey  String?         @map("idempotency_key")
  contractVersion String          @default("1.0.0") @map("contract_version")
  pipelineVersion String          @default("1.0.0") @map("pipeline_version")
  status          IngestionStatus @default(RECEIVED)
  attempts        Int             @default(0)
  maxRetries      Int             @default(3) @map("max_retries")
  itemId          String?         @map("item_id") @db.Uuid
  item            Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  lastError       String?         @map("last_error")
  executionLog    Json?           @map("execution_log") @db.JsonB
  reviewData      Json?           @map("review_data") @db.JsonB
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([projectId, status])
  @@index([idempotencyKey])
  @@map("ingestion_runs")
}

model CapturePreview {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sourceUrl         String    @map("source_url")
  canonicalMetadata Json      @map("canonical_metadata") @db.JsonB
  metadataDigest    String    @map("metadata_digest")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("capture_previews")
}
