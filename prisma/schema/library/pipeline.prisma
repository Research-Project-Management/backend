// ============================================================================
// Library Shared Kernel: Pipeline Sub-Domain
// Self-managed domain schema: IngestionRun, IngestionStatus, IngestionStage
// ============================================================================

enum IngestionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCELLED
  STALLED
}

enum IngestionStage {
  IDENTIFY
  EXTRACT
  NORMALIZE
  ENRICH
  RECONCILE
  MATCH
  COMMIT
}

model IngestionRun {
  id              String          @id @default(uuid(7)) @db.Uuid
  spaceId         String          @map("space_id") @db.Uuid
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_ingestion_runs_space_id")
  createdById     String          @map("created_by_id") @db.Uuid
  traceId         String?         @map("trace_id") @db.VarChar(64)
  inputParams     Json            @map("input_params") @db.JsonB
  inputHash       String          @map("input_hash") @db.VarChar(64)
  idempotencyKey  String?         @map("idempotency_key") @db.VarChar(128)
  contractVersion String          @default("1.0.0") @map("contract_version") @db.VarChar(16)
  pipelineVersion String          @default("1.0.0") @map("pipeline_version") @db.VarChar(16)
  status          IngestionStatus @default(PENDING)
  currentStage    IngestionStage? @map("current_stage")
  attempts        Int             @default(0)
  maxRetries      Int             @default(3) @map("max_retries")
  nextRetryAt     DateTime?       @map("next_retry_at") @db.Timestamptz(6)
  itemId          String?         @map("item_id") @db.Uuid
  item            LibraryItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull, map: "fk_ingestion_runs_item_id")
  lastError       String?         @map("last_error")
  executionLog    Json?           @map("execution_log") @db.JsonB
  reviewData      Json?           @map("review_data") @db.JsonB
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([spaceId, idempotencyKey])
  @@index([spaceId, startedAt(sort: Desc)])
  @@index([createdById, startedAt(sort: Desc)])
  @@index([itemId])
  @@index([status, nextRetryAt])
  @@index([status, updatedAt])
  @@index([status, completedAt])
  @@index([spaceId, inputHash])
  @@map("ingestion_runs")
}

model CapturePreview {
  id                String    @id @default(uuid(7)) @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  sourceUrl         String    @map("source_url") @db.Text
  spaceId           String    @map("space_id") @db.Uuid
  space             Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_capture_previews_space_id")
  createdById       String    @map("created_by_id") @db.Uuid
  canonicalMetadata Json      @map("canonical_metadata") @db.JsonB
  metadataDigest    String?   @map("metadata_digest") @db.VarChar(128)
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([spaceId, expiresAt])
  @@index([createdById, expiresAt])
  @@index([expiresAt])
  @@map("capture_previews")
}
