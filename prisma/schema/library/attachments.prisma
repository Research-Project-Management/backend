// ============================================================================
// Library Shared Kernel: Attachments Sub-Domain
// Self-managed domain schema: Attachments, Revisions, Annotations, FullTextIndex
// ============================================================================

enum LinkMode {
  imported_file
  imported_url
  linked_url
  linked_file
}

enum AttachmentType {
  primary_pdf
  supplementary
  dataset
  slides
  code
  figure
  snapshot
  other
  preview
}

enum AttachmentExtractionStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  FAILED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum AnnotationType {
  highlight
  underline
  strike
  note
  rect
  text
  image
  ink
}

model Attachment {
  id                    String                     @id @default(uuid(7)) @db.Uuid
  itemId                String                     @map("item_id") @db.Uuid
  item                  LibraryItem                @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "fk_attachments_item_id")
  linkMode              LinkMode                   @default(imported_file) @map("link_mode")
  attachmentType        AttachmentType             @default(primary_pdf) @map("attachment_type")
  filename              String                     @default("document.pdf")
  url                   String                     @default("")
  fileHash              String?                    @map("file_hash")
  fileId                String?                    @map("file_id") @db.Uuid
  storageKey            String?                    @map("storage_key")
  mimeType              String                     @default("application/pdf") @map("mime_type")
  size                  BigInt                     @default(0)
  pageCount             Int?                       @map("page_count")
  extractionStatus      AttachmentExtractionStatus @default(PENDING) @map("extraction_status")
  extractionAttempts    Int                        @default(0) @map("extraction_attempts")
  extractionStartedAt   DateTime?                  @map("extraction_started_at") @db.Timestamptz(6)
  extractionCompletedAt DateTime?                  @map("extraction_completed_at") @db.Timestamptz(6)
  extractionLastError   String?                    @map("extraction_last_error")
  isPrimary             Boolean                    @default(false) @map("is_primary")
  metadata              Json?                      @default("{}") @db.JsonB
  createdById           String?                    @map("created_by_id") @db.Uuid
  deletedById           String?                    @map("deleted_by_id") @db.Uuid
  version               Int                        @default(1)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                  @map("deleted_at") @db.Timestamptz(6)

  revisions             AttachmentRevision[]
  annotations           Annotation[]
  fullTextIndexes       FullTextIndex[]
  structure             AttachmentStructure?
  readingStates         AttachmentReadingState[]

  @@index([itemId, deletedAt, attachmentType])
  @@index([itemId, deletedAt, fileId])
  @@index([itemId, deletedAt, createdAt])
  @@index([fileId, deletedAt])
  @@index([fileHash])
  @@index([extractionStatus, extractionStartedAt])
  @@map("attachments")
}

model AttachmentRevision {
  id             String     @id @default(uuid(7)) @db.Uuid
  attachmentId   String     @map("attachment_id") @db.Uuid
  attachment     Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade, map: "fk_attachment_revisions_attachment_id")
  revisionNumber Int        @default(1) @map("revision_number")
  fileId         String?    @map("file_id") @db.Uuid
  fileHash       String?    @map("file_hash")
  sizeBytes      BigInt     @default(0) @map("size_bytes")
  url            String     @default("")
  comment        String?    @default("")
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attachmentId, revisionNumber])
  @@index([fileId])
  @@map("attachment_revisions")
}

model Annotation {
  id                  String         @id @default(uuid(7)) @db.Uuid
  attachmentId        String         @map("attachment_id") @db.Uuid
  attachment          Attachment     @relation(fields: [attachmentId], references: [id], onDelete: Cascade, map: "fk_annotations_attachment_id")
  itemId              String?        @map("item_id") @db.Uuid
  imageFileId         String?        @map("image_file_id") @db.Uuid
  type                AnnotationType @default(highlight)
  color               String         @default("#ffeb3b")
  pageIndex           Int            @default(0) @map("page_index")
  pageLabel           String?        @default("") @map("page_label")
  annotationSortIndex String         @default("") @map("annotation_sort_index")
  rectCoords          Json?          @map("rect_coords") @db.JsonB
  quoteText           String?        @map("quote_text")
  comment             String?        @default("")
  tags                String[]       @default([])
  createdById         String         @map("created_by_id") @db.Uuid
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)

  @@index([attachmentId, deletedAt, pageIndex, annotationSortIndex, createdAt])
  @@index([attachmentId, deletedAt, type, pageIndex, annotationSortIndex])
  @@index([itemId, deletedAt, pageIndex, annotationSortIndex])
  @@index([createdById, deletedAt])
  @@index([tags], type: Gin)
  @@map("annotations")
}

model FullTextIndex {
  attachmentId String                   @map("attachment_id") @db.Uuid
  attachment   Attachment               @relation(fields: [attachmentId], references: [id], onDelete: Cascade, map: "fk_full_text_indexes_attachment_id")
  itemId       String?                  @map("item_id") @db.Uuid
  pageIndex    Int                      @map("page_index")
  textContent  String                   @map("text_content")
  charOffset   Int                      @default(0) @map("char_offset")
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([attachmentId, pageIndex])
  @@index([itemId, attachmentId])
  @@index([searchVector], type: Gin)
  @@map("full_text_indexes")
}

model AttachmentStructure {
  attachmentId      String      @id @map("attachment_id") @db.Uuid
  attachment        Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade, map: "fk_attachment_structures_attachment_id")
  itemId            String      @map("item_id") @db.Uuid
  item              LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "fk_attachment_structures_item_id")
  isScanned         Boolean     @default(false) @map("is_scanned")
  ocrStatus         String?     @map("ocr_status") @db.VarChar(32)
  qualityScore      Float?      @map("quality_score") @db.Real
  engineUsed        String?     @map("engine_used") @db.VarChar(64)
  pageCount         Int         @default(0) @map("page_count")
  sections          Json        @default("[]") @db.JsonB
  figures           Json        @default("[]") @db.JsonB
  tables            Json        @default("[]") @db.JsonB
  formulas          Json        @default("[]") @db.JsonB
  references        Json        @default("[]") @db.JsonB
  fulltextFileId    String?     @map("fulltext_file_id") @db.Uuid
  fulltextByteSize  Int?        @map("fulltext_byte_size")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([itemId])
  @@map("attachment_structures")
}
