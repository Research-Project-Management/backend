// ============================================================================
// Library Shared Kernel: Sync & Outbox Sub-Domain
// Self-managed domain schema: SyncSequence, LibraryChange, Tombstone, OutboxEvent, LibraryInboxRecord, IdempotencyRecord
// ============================================================================

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model IdempotencyRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  scopeKey       String    @default("") @map("scope_key") @db.VarChar(128)
  userId         String    @map("user_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body") @db.JsonB
  status         String    @default("in_progress")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scopeKey, idempotencyKey])
  @@index([userId, idempotencyKey])
  @@index([projectId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model LibraryInboxRecord {
  consumer       String    @db.VarChar(128)
  eventId        String    @map("event_id") @db.VarChar(128)
  status         String    @default("processing") @db.VarChar(32)
  ownerToken     String?   @map("owner_token") @db.VarChar(64)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([expiresAt])
  @@index([status, leaseExpiresAt])
  @@map("library_inbox_records")
}

model SyncSequence {
  id              String   @id @default(uuid(7)) @db.Uuid
  scopeKey        String   @unique @default("") @map("scope_key") @db.VarChar(128)
  userId          String?  @unique @map("user_id") @db.Uuid
  projectId       String?  @unique @map("project_id") @db.Uuid
  currentSequence BigInt   @default(0) @map("current_sequence")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sync_sequences")
}

model LibraryChange {
  id          String   @id @default(uuid(7)) @db.Uuid
  scopeKey    String   @default("") @map("scope_key") @db.VarChar(128)
  seq         BigInt
  userId      String?  @map("user_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  version     Int
  data        Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scopeKey, seq])
  @@index([scopeKey, entityType, entityId, seq(sort: Desc)])
  @@index([userId, projectId, seq])
  @@index([projectId, seq])
  @@index([userId, projectId, entityType, entityId, seq(sort: Desc)])
  @@index([projectId, entityType, entityId, seq(sort: Desc)])
  @@index([createdAt])
  @@map("library_changes")
}

model Tombstone {
  id          String    @id @default(uuid(7)) @db.Uuid
  scopeKey    String    @default("") @map("scope_key") @db.VarChar(128)
  userId      String?   @map("user_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  seq         BigInt
  deletedById String?   @map("deleted_by_id") @db.Uuid
  deletedAt   DateTime  @default(now()) @map("deleted_at") @db.Timestamptz(6)

  @@unique([scopeKey, entityType, entityId])
  @@index([scopeKey, seq])
  @@index([userId, projectId, entityType, entityId])
  @@index([userId, projectId, seq])
  @@index([projectId, seq])
  @@index([projectId, entityType, entityId])
  @@index([deletedAt])
  @@map("tombstones")
}

model OutboxEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  projectId      String?      @map("project_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  aggregateId    String       @map("aggregate_id")
  eventType      String       @map("event_type")
  payload        Json         @db.JsonB
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  error          String?
  scheduledAt    DateTime?    @map("scheduled_at") @db.Timestamptz(6)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  claimedBy      String?      @map("claimed_by")
  dedupeKey      String?      @unique @map("dedupe_key")
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, leaseExpiresAt])
  @@index([status, scheduledAt, leaseExpiresAt])
  @@index([aggregateId, status])
  @@map("outbox_events")
}
