// ============================================================================
// Library Shared Kernel: Catalog Sub-Domain
// Self-managed domain schema: LibraryItem, Contributor, Relations, Metadata Sources
// ============================================================================

enum RelationType {
  cites
  cited_by
  replicates
  extends
  is_preprint_of
  is_published_version_of
  is_translation_of
  supplements
  related
  rebuts
  uses_dataset
  survey_of
}

model LibraryItem {
  id                  String      @id @default(uuid(7)) @db.Uuid
  spaceId             String      @map("space_id") @db.Uuid
  space               Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_library_items_space_id")
  title               String
  itemType            String      @default("journalArticle") @map("type")
  year                Int?
  citationKey         String?     @map("citation_key")
  doi                 String?
  isbn                String?
  issn                String?
  pmid                String?
  pmcid               String?
  arxivId             String?     @map("arxiv_id")
  publicationTitle    String?     @map("publication_title")
  abstract            String?
  url                 String?
  metadata            Json        @default("{}") @db.JsonB
  createdById         String      @map("created_by_id") @db.Uuid
  updatedById         String?     @map("updated_by_id") @db.Uuid
  deletedById         String?     @map("deleted_by_id") @db.Uuid
  version             Int         @default(1)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Fast-Display Denormalized Fields & Counter Caches
  hasFile             Boolean                  @default(false) @map("has_file")
  attachmentCount     Int                      @default(0) @map("attachment_count")
  noteCount           Int                      @default(0) @map("note_count")
  firstAuthor         String?                  @map("first_author") @db.VarChar(255)
  isRetracted         Boolean                  @default(false) @map("is_retracted")
  retractionCheckedAt DateTime?                @map("retraction_checked_at") @db.Timestamptz(6)
  searchVector        Unsupported("tsvector")? @map("search_vector")

  // Canonical Relations across Library Sub-Domains
  attachments             Attachment[]
  contributors            Contributor[]
  identifiers             ItemIdentifier[]
  collectionItems         LibraryCollectionItem[]
  itemTags                LibraryItemTag[]
  notesList               LibraryNote[]
  outgoingRel             ItemRelation[]           @relation("SourceItem")
  incomingRel             ItemRelation[]           @relation("TargetItem")
  states                  LibraryItemState[]
  attachmentReadingStates AttachmentReadingState[]
  attachmentStructures    AttachmentStructure[]
  ingestionRuns           IngestionRun[]
  itemMetadata            ItemMetadata[]
  publications            UserPublication[]

  @@index([spaceId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([spaceId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([spaceId, deletedAt, year(sort: Desc), id(sort: Desc)])
  @@index([spaceId, deletedAt, firstAuthor, id])
  @@index([spaceId, deletedAt, title, id])
  @@index([spaceId, deletedAt, publicationTitle, id])
  @@index([spaceId, deletedAt, citationKey, id])
  @@index([spaceId, deletedAt, itemType])
  @@index([spaceId, deletedAt, hasFile, createdAt(sort: Desc), id(sort: Desc)])
  @@index([spaceId, deletedAt, isRetracted, createdAt(sort: Desc), id(sort: Desc)])
  @@index([spaceId, deletedAt, arxivId])
  @@index([spaceId, deletedAt, pmid])
  @@index([createdById])
  @@index([doi, deletedAt])
  @@index([citationKey, deletedAt])
  @@index([deletedAt, retractionCheckedAt])
  @@index([metadata], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("library_items")
}

model Contributor {
  id           String            @id @default(uuid(7)) @db.Uuid
  itemId       String            @map("item_id") @db.Uuid
  item         LibraryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "fk_contributors_item_id")
  creatorType  String            @default("author") @map("creator_type")
  fieldMode    Int               @default(0) @map("field_mode") // 0 = personal (two-field), 1 = single-field institution
  firstName    String?           @default("") @map("first_name")
  lastName     String?           @default("") @map("last_name")
  fullName     String            @map("full_name")
  shortName    String?           @default("") @map("short_name") @db.VarChar(255)
  orderIndex   Int               @default(0) @map("order_index")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  publications UserPublication[]

  @@index([itemId, orderIndex])
  @@index([lastName, firstName])
  @@index([fullName])
  @@map("contributors")
}

model ItemRelation {
  id           String       @id @default(uuid(7)) @db.Uuid
  sourceItemId String       @map("source_item_id") @db.Uuid
  sourceItem   LibraryItem  @relation("SourceItem", fields: [sourceItemId], references: [id], onDelete: Cascade, map: "fk_item_relations_source_item_id")
  targetItemId String       @map("target_item_id") @db.Uuid
  targetItem   LibraryItem  @relation("TargetItem", fields: [targetItemId], references: [id], onDelete: Cascade, map: "fk_item_relations_target_item_id")
  relationType RelationType @default(related) @map("relation_type")
  description  String?      @default("")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceItemId, targetItemId, relationType])
  @@index([targetItemId])
  @@map("item_relations")
}

model ItemMetadata {
  id             String      @id @default(uuid(7)) @db.Uuid
  itemId         String      @map("item_id") @db.Uuid
  item           LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "fk_item_metadata_item_id")
  sourceUri      String?     @default("") @map("source_uri")
  sourceProvider String      @default("arxiv") @map("source_provider") @db.VarChar(64)
  rawPayload     Json        @map("raw_payload") @db.JsonB
  format         String?     @default("json") @map("format") @db.VarChar(32)
  fetchedAt      DateTime    @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([itemId, sourceProvider, createdAt(sort: Desc)])
  @@index([itemId, createdAt(sort: Desc)])
  @@map("item_metadata")
}

model Retraction {
  id               String    @id @default(uuid(7)) @db.Uuid
  doi              String    @unique @db.VarChar(255)
  pmid             String?   @db.VarChar(32)
  title            String?   @db.Text
  isRetracted      Boolean   @default(true) @map("is_retracted")
  nature           String    @default("retraction") @db.VarChar(32)
  retractionDate   DateTime? @map("retraction_date") @db.Timestamptz(6)
  noticeType       String?   @map("notice_type") @db.VarChar(64)
  noticeUrl        String?   @map("notice_url") @db.Text
  reason           String?   @db.Text
  journal          String?   @db.VarChar(512)
  source           String    @default("crossref") @db.VarChar(64)
  rawMetadata      Json?     @map("raw_metadata") @db.JsonB
  checkedAt        DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([pmid])
  @@index([isRetracted, nature])
  @@index([checkedAt(sort: Desc)])
  @@map("retractions")
}

model UserPublication {
  userId            String       @map("user_id") @db.Uuid
  itemId            String       @map("item_id") @db.Uuid
  item              LibraryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "fk_user_publications_item_id")
  contributorId     String?      @map("contributor_id") @db.Uuid
  contributor       Contributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull, map: "fk_user_publications_contributor_id")
  isPublic          Boolean      @default(false) @map("is_public")
  openAccessLicense String?      @map("open_access_license")
  addedAt           DateTime     @default(now()) @map("added_at") @db.Timestamptz(6)

  @@id([userId, itemId])
  @@index([userId, isPublic])
  @@index([itemId])
  @@index([contributorId])
  @@map("user_publications")
}

model ItemIdentifier {
  id           String      @id @default(uuid(7)) @db.Uuid
  itemId       String      @map("item_id") @db.Uuid
  item         LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "fk_item_identifiers_item_id")
  type         String      @db.VarChar(64)
  value        String      @db.Text
  canonicalUri String?     @map("canonical_uri") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([itemId, type], name: "itemId_type")
  @@index([type, value])
  @@map("item_identifiers")
}

model CitationStyle {
  id          String   @id @default(uuid(7)) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_citation_styles_space_id")
  createdById String   @map("created_by_id") @db.Uuid
  slug        String   @db.VarChar(128)
  title       String   @db.VarChar(512)
  xmlContent  String   @map("xml_content") @db.Text
  sha256      String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([spaceId, slug])
  @@index([spaceId])
  @@map("citation_styles")
}
