// -- 8. Activity Stream & Audit Log Context (Activity Microservice) -----------

model ActivityEvent {
  id            String     @id @default(uuid()) @db.Uuid
  entityType    EntityType @map("entity_type")
  entityId      String     @map("entity_id")
  verb          String
  field         String?
  oldValue      String?    @map("old_value")
  newValue      String?    @map("new_value")
  oldIdentifier String?    @map("old_identifier")
  newIdentifier String?    @map("new_identifier")
  actorId       String     @map("actor_id") @db.Uuid
  actor         User       @relation("UserActivityEvents", fields: [actorId], references: [id], onDelete: Cascade)
  projectId     String?    @map("project_id") @db.Uuid
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_events")
}
