// Third-Party Integrations Domain

enum IntegrationProvider {
  zotero
  mendeley
  orcid
  github
}

enum IntegrationStatus {
  connected
  expired
  revoked
  error
}

model UserIntegration {
  id       String              @id @default(uuid(7)) @db.Uuid
  userId   String              @map("user_id") @db.Uuid
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider IntegrationProvider
  status   IntegrationStatus   @default(connected)

  // Tokens encrypted with AES-256-GCM (iv:authTag:ciphertext)
  accessToken    String    @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)

  providerUserId String  @map("provider_user_id") @db.VarChar(255)
  accountName    String? @map("account_name") @db.VarChar(255)
  accountEmail   String? @map("account_email") @db.VarChar(255)
  metadata       Json?   @db.JsonB

  authFailedAt DateTime? @map("auth_failed_at") @db.Timestamptz(6)
  connectedAt  DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  referenceLinks PageReferenceLink[]
  githubLinks    PageGithubLink[]

  @@unique([userId, provider])
  @@index([provider])
  @@map("user_integrations")
}

model PageReferenceLink {
  id                String          @id @default(uuid(7)) @db.Uuid
  pageId            String          @map("page_id") @db.Uuid
  page              Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userIntegrationId String          @map("user_integration_id") @db.Uuid
  userIntegration   UserIntegration @relation(fields: [userIntegrationId], references: [id], onDelete: Cascade)

  collectionId   String @map("collection_id") @db.VarChar(255)
  collectionName String @map("collection_name") @db.VarChar(255)
  targetBibFile  String @default("references.bib") @map("target_bib_file") @db.VarChar(255)

  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([pageId, userIntegrationId, collectionId])
  @@index([pageId])
  @@index([userIntegrationId])
  @@map("page_reference_links")
}

model PageGithubLink {
  id                String          @id @default(uuid(7)) @db.Uuid
  pageId            String          @unique @map("page_id") @db.Uuid
  page              Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userIntegrationId String          @map("user_integration_id") @db.Uuid
  userIntegration   UserIntegration @relation(fields: [userIntegrationId], references: [id], onDelete: Cascade)

  repoFullName String @map("repo_full_name") @db.VarChar(255)
  branch       String @default("main") @db.VarChar(255)

  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userIntegrationId])
  @@map("page_github_links")
}
