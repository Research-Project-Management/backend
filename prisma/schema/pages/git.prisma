// ============================================================================
// Pages Subsystem: Git Bridge Sub-Domain (Normalized 1NF -> 2NF -> 3NF -> BCNF)
// Models:
//   1. GitAccessToken — User-scoped Personal Access Tokens (CK: {id}, {tokenHash})
//   2. PageGitRepo    — 1:1 Persistent Git Repository State per Page (PK/FK: {pageId})
//   3. GitPushEvent   — Immutable Push Lineage & Snapshot Link (CK: {id}, {snapshotId})
// ============================================================================

model GitAccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation("UserGitAccessTokens", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_git_access_tokens_user")
  label      String    @db.VarChar(100)
  tokenHint  String    @map("token_hint") @db.Char(8)
  tokenHash  String    @unique(map: "uq_git_access_tokens_hash") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "idx_git_access_tokens_user_created")
  @@index([expiresAt], map: "idx_git_access_tokens_expires_at")
  @@map("git_access_tokens")
}

model PageGitRepo {
  pageId         String    @id @map("page_id") @db.Uuid
  page           Page      @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_git_repos_page")
  headCommitOid  String?   @map("head_commit_oid") @db.Char(40)
  rootTreeOid    String?   @map("root_tree_oid") @db.Char(40)
  isMaterialized Boolean   @default(false) @map("is_materialized")
  gcPushCount    Int       @default(0) @map("gc_push_count")
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  pushEvents GitPushEvent[]

  @@index([isMaterialized, lastAccessedAt], map: "idx_page_git_repos_eviction")
  @@map("page_git_repos")
}

model GitPushEvent {
  id            String        @id @default(uuid(7)) @db.Uuid
  pageId        String        @map("page_id") @db.Uuid
  repo          PageGitRepo   @relation(fields: [pageId], references: [pageId], onDelete: Cascade, onUpdate: Cascade, map: "fk_git_push_events_repo")
  pusherId      String?       @map("pusher_id") @db.Uuid
  pusher        User?         @relation("UserGitPushEvents", fields: [pusherId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_git_push_events_pusher")
  snapshotId    String?       @unique(map: "uq_git_push_events_snapshot") @map("snapshot_id") @db.Uuid
  snapshot      PageSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_git_push_events_snapshot")
  beforeOid     String?       @map("before_oid") @db.Char(40)
  afterOid      String        @map("after_oid") @db.Char(40)
  commitSubject String?       @map("commit_subject") @db.VarChar(255)
  addedCount    Int           @default(0) @map("added_count")
  modifiedCount Int           @default(0) @map("modified_count")
  deletedCount  Int           @default(0) @map("deleted_count")
  totalBytes    Int           @default(0) @map("total_bytes")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pageId, afterOid], map: "uq_git_push_events_page_after_oid")
  @@index([pageId, createdAt(sort: Desc)], map: "idx_git_push_events_page_created")
  @@index([pusherId, createdAt(sort: Desc)], map: "idx_git_push_events_pusher_created")
  @@map("git_push_events")
}
