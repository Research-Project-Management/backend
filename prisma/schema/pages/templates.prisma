// ============================================================================
// Pages Subsystem: Templates & Starters Sub-Domain
// Self-managed domain schema: PageTemplate
// ============================================================================

enum PageTemplateCategory {
  journal
  conference
  thesis
  cv
  presentation
  report
  other
}

model PageTemplate {
  id            String               @id @default(uuid(7)) @db.Uuid
  versionId     String               @unique @map("version_id") @db.VarChar(64)
  name          String               @db.VarChar(255)
  category      PageTemplateCategory @default(other)
  description   String?              @db.Text
  compiler      String               @default("pdflatex") @db.VarChar(32)
  imageName     String?              @map("image_name") @db.VarChar(128)
  mainFile      String               @default("main.tex") @map("main_file") @db.VarChar(255)
  thumbnailUrl  String?              @map("thumbnail_url") @db.Text
  author        String               @default("Flux Community") @db.VarChar(255)
  tags          String[]             @default([])
  isOfficial    Boolean              @default(false) @map("is_official")
  downloadCount Int                  @default(0) @map("download_count")
  files         Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, isOfficial, downloadCount(sort: Desc)], map: "idx_page_templates_cat")
  @@index([isOfficial(sort: Desc), downloadCount(sort: Desc)], map: "idx_page_templates_official_downloads")
  @@index([downloadCount(sort: Desc)], map: "idx_page_templates_downloads")
  @@map("page_templates")
}
