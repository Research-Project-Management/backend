// ============================================================================
// Pages Subsystem: Templates & Gallery Sub-Domain (Normalized BCNF / 4NF)
// Aligned 1:1 with Flux Unified Space (`personal` | `project`), `Page`, and `FileBlob` CAS:
//   - Built-in academic presets live in immutable domain catalog (like `CitationStyle` presets)
//   - Persisted `PageTemplate` rows belong strictly to a `Space` (`personal` | `project`)
//   - Zero binary BYTEA in PostgreSQL: text stored in `TemplateBlob.textContent`,
//     binary assets reference platform CAS `FileBlob` (`blobId` / `storageKey`).
// ============================================================================

enum TemplateCategory {
  journal
  conference
  book
  letter
  assignment
  poster
  presentation
  report
  cv
  thesis
  other
}

model TemplateBlob {
  contentHash String    @id @map("content_hash") @db.Char(64)
  textContent String?   @map("text_content") @db.Text
  blobId      String?   @map("blob_id") @db.Uuid
  blob        FileBlob? @relation("TemplateFileBlobs", fields: [blobId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_template_blobs_file_blob")
  storageKey  String?   @map("storage_key") @db.VarChar(512)
  bucketName  String?   @map("bucket_name") @db.VarChar(128)
  mimeType    String    @default("text/x-tex") @map("mime_type") @db.VarChar(128)
  sizeBytes   Int       @default(0) @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  templateFiles PageTemplateFile[]

  @@index([blobId], map: "idx_template_blobs_blob_id")
  @@map("template_blobs")
}

model PageTemplate {
  id           String           @id @default(uuid(7)) @db.Uuid
  spaceId      String           @map("space_id") @db.Uuid
  space        Space            @relation("SpacePageTemplates", fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_templates_space")
  sourcePageId String?          @map("source_page_id") @db.Uuid
  sourcePage   Page?            @relation("SourcePageTemplates", fields: [sourcePageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_page_templates_source_page")
  createdById  String           @map("created_by_id") @db.Uuid
  createdBy    User             @relation("UserPageTemplates", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_templates_creator")
  slug         String           @db.VarChar(128)
  name         String           @db.VarChar(255)
  category     TemplateCategory @default(other)
  description  String?          @db.Text
  compiler     String           @default("pdflatex") @db.VarChar(32)
  texlive      String           @default("2025") @db.VarChar(16)
  mainFile     String           @default("main.tex") @map("main_file") @db.VarChar(255)
  thumbnail    String?          @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  files PageTemplateFile[]
  tags  PageTemplateTag[]

  @@unique([spaceId, slug], map: "uq_page_templates_space_slug")
  @@index([spaceId, category, updatedAt(sort: Desc)], map: "idx_page_templates_space_cat_updated")
  @@index([sourcePageId, spaceId], map: "idx_page_templates_source_page")
  @@index([createdById, createdAt(sort: Desc)], map: "idx_page_templates_creator")
  @@map("page_templates")
}

model PageTemplateFile {
  templateId  String       @map("template_id") @db.Uuid
  template    PageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_template_files_template")
  pathname    String       @db.VarChar(512)
  type        PageNodeType @default(DOC)
  contentHash String       @map("content_hash") @db.Char(64)
  blob        TemplateBlob @relation(fields: [contentHash], references: [contentHash], onDelete: Restrict, onUpdate: Cascade, map: "fk_page_template_files_blob")

  @@id([templateId, pathname])
  @@index([contentHash], map: "idx_page_template_files_hash")
  @@map("page_template_files")
}

model PageTemplateTag {
  templateId String       @map("template_id") @db.Uuid
  template   PageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_template_tags_template")
  tag        String       @db.VarChar(64)

  @@id([templateId, tag])
  @@index([tag, templateId], map: "idx_page_template_tags_lookup")
  @@map("page_template_tags")
}
