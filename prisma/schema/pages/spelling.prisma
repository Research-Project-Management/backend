// ============================================================================
// Pages Subsystem: Spelling Dictionary
// Model: SpellingWord
// ============================================================================

model SpellingWord {
  id          String   @id @default(uuid(7)) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_spelling_words_space_id")
  word        String   @db.VarChar(128)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([spaceId, word], map: "uq_spelling_words_space_word")
  @@map("spelling_words")
}
