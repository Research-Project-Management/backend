// ============================================================================
// Pages Subsystem: Document & Lines Sub-Domain
// Self-managed domain schema: PageDoc
// ============================================================================

model PageDoc {
  id            String    @id @default(uuid(7)) @db.Uuid
  spaceId       String    @map("space_id") @db.Uuid
  pageId        String    @map("page_id") @db.Uuid
  page          Page      @relation(fields: [pageId, spaceId], references: [id, spaceId], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_docs_page_space")
  lastKnownPath String    @map("last_known_path") @db.VarChar(1000)
  lines         Json      @default("[]") @db.JsonB
  rev           Int       @default(0)
  version       Int       @default(0)
  ranges        Json?     @default("{}") @db.JsonB
  hash          String?   @db.VarChar(64)
  sizeBytes     Int       @default(0) @map("size_bytes")
  inStorage     Boolean   @default(false) @map("in_storage")
  storageKey    String?   @map("storage_key") @db.VarChar(512)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  node           PageNode?
  rootForPages   Page[]       @relation("PageRootDoc")
  docChanges     DocChange[]
  docComments    DocComment[]
  docReview      DocReview?

  @@unique([id, pageId], map: "uq_page_docs_id_page")
  @@index([pageId, deletedAt, updatedAt(sort: Desc)], map: "idx_page_docs_page_del_updated")
  @@index([pageId, deletedAt, lastKnownPath], map: "idx_page_docs_page_del_path")
  @@index([spaceId, deletedAt], map: "idx_page_docs_space_deleted")
  @@index([spaceId, deletedAt, lastKnownPath], map: "idx_page_docs_space_del_path")
  @@index([spaceId, inStorage], map: "idx_page_docs_space_storage")
  @@map("page_docs")
}
