// ============================================================================
// Pages Subsystem: Document & Lines Sub-Domain
// Self-managed domain schema: PageDoc
// ============================================================================

model PageDoc {
  id         String    @id @default(uuid(7)) @db.Uuid
  spaceId    String    @map("space_id") @db.Uuid
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_docs_space_id")
  pageId     String?   @map("page_id") @db.Uuid
  page       Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_docs_page_id")
  path       String    @db.VarChar(1000)
  lines      Json      @default("[]")
  rev        Int       @default(0)
  version    Int       @default(0)
  ranges     Json?     @default("{}")
  hash       String?   @db.VarChar(64)
  sizeBytes  Int       @default(0) @map("size_bytes")
  inStorage  Boolean   @default(false) @map("in_storage")
  storageKey String?   @map("storage_key") @db.VarChar(512)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  node            PageNode?
  rootForPages    Page[]              @relation("PageRootDoc")
  trackChanges    PageTrackChange[]
  commentThreads  PageCommentThread[]
  notifications   PageNotification[]
  docReview       PageDocReview?

  @@index([spaceId, deletedAt, updatedAt], map: "idx_page_docs_space_del_updated")
  @@index([spaceId, deletedAt, createdAt], map: "idx_page_docs_space_del_created")
  @@index([spaceId, deletedAt(sort: Desc)], map: "idx_page_docs_space_deleted_at")
  @@index([spaceId, deletedAt, path], map: "idx_page_docs_space_del_path")
  @@index([pageId, deletedAt, path], map: "idx_page_docs_page_del_path")
  @@index([spaceId, inStorage], map: "idx_page_docs_space_storage")
  @@map("page_docs")
}
