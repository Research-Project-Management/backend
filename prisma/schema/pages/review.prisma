// ============================================================================
// Pages Subsystem: Review, Document Changes & Comments Sub-Domain
// Normalized 3NF schema matching library conventions:
// DocReview, ReviewRound, DocChange, DocComment, CommentReply, CommentMention
// ============================================================================

enum ChangeType {
  insert
  delete
}

enum ChangeStatus {
  pending
  accepted
  rejected
}

enum ReviewStatus {
  draft
  in_review
  changes_requested
  approved
  submitted
  locked
}

model DocReview {
  docId        String       @id @map("doc_id") @db.Uuid
  doc          PageDoc      @relation(fields: [docId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_doc_reviews_doc_id")
  status       ReviewStatus @default(draft)
  currentRound Int          @default(1) @map("current_round")
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  rounds ReviewRound[]

  @@index([status], map: "idx_doc_reviews_status")
  @@map("doc_reviews")
}

model ReviewRound {
  id            String       @id @default(uuid(7)) @db.Uuid
  docId         String       @map("doc_id") @db.Uuid
  review        DocReview    @relation(fields: [docId], references: [docId], onDelete: Cascade, map: "fk_review_rounds_doc_id")
  roundNumber   Int          @default(1) @map("round_number")
  status        ReviewStatus @default(in_review)
  requestedById String?      @map("requested_by_id") @db.Uuid
  requestedAt   DateTime?    @map("requested_at") @db.Timestamptz(6)
  verdictById   String?      @map("verdict_by_id") @db.Uuid
  verdictAt     DateTime?    @map("verdict_at") @db.Timestamptz(6)
  notes         String?      @db.Text
  deadline      DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([docId, roundNumber], map: "uq_review_rounds_doc_round")
  @@index([docId, createdAt(sort: Desc)], map: "idx_review_rounds_doc_created")
  @@map("review_rounds")
}

model DocChange {
  id           String       @id @default(uuid(7)) @db.Uuid
  docId        String       @map("doc_id") @db.Uuid
  doc          PageDoc      @relation(fields: [docId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_doc_changes_doc_id")
  groupId      String?      @map("group_id") @db.Uuid
  type         ChangeType
  status       ChangeStatus @default(pending)
  text         String       @db.Text
  startLine    Int          @map("start_line")
  startCol     Int          @map("start_col")
  endLine      Int          @map("end_line")
  endCol       Int          @map("end_col")
  anchorStart  Bytes?       @map("anchor_start")
  anchorEnd    Bytes?       @map("anchor_end")
  baseDocRev   Int?         @map("base_doc_rev")
  version      Int          @default(1)
  createdById  String?      @map("created_by_id") @db.Uuid
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([docId, status, createdAt(sort: Desc)], map: "idx_doc_changes_doc_status")
  @@index([docId, groupId, status], map: "idx_doc_changes_doc_group_status")
  @@index([groupId], map: "idx_doc_changes_group_id")
  @@index([createdById], map: "idx_doc_changes_author")
  @@map("doc_changes")
}

model DocComment {
  id           String    @id @default(uuid(7)) @db.Uuid
  docId        String    @map("doc_id") @db.Uuid
  doc          PageDoc   @relation(fields: [docId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_doc_comments_doc_id")
  quote        String?   @db.Text
  startLine    Int       @map("start_line")
  startCol     Int       @map("start_col")
  endLine      Int       @map("end_line")
  endCol       Int       @map("end_col")
  anchorStart  Bytes?    @map("anchor_start")
  anchorEnd    Bytes?    @map("anchor_end")
  baseDocRev   Int?      @map("base_doc_rev")
  isResolved   Boolean   @default(false) @map("is_resolved")
  version      Int       @default(1)
  createdById  String?   @map("created_by_id") @db.Uuid
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  replies CommentReply[]

  @@index([docId, deletedAt, isResolved, createdAt(sort: Desc)], map: "idx_doc_comments_doc_resolved")
  @@index([createdById], map: "idx_doc_comments_author")
  @@map("doc_comments")
}

model CommentReply {
  id          String     @id @default(uuid(7)) @db.Uuid
  commentId   String     @map("comment_id") @db.Uuid
  comment     DocComment @relation(fields: [commentId], references: [id], onDelete: Cascade, map: "fk_comment_replies_comment_id")
  content     String     @db.Text
  version     Int        @default(1)
  createdById String?    @map("created_by_id") @db.Uuid
  updatedById String?    @map("updated_by_id") @db.Uuid
  deletedById String?    @map("deleted_by_id") @db.Uuid
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentions CommentMention[]

  @@index([commentId, deletedAt, createdAt], map: "idx_comment_replies_comment_created")
  @@map("comment_replies")
}

model CommentMention {
  replyId   String       @map("reply_id") @db.Uuid
  reply     CommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade, map: "fk_comment_mentions_reply_id")
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([replyId, userId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_comment_mentions_user_created")
  @@map("comment_mentions")
}
