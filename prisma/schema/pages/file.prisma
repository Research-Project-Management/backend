// ============================================================================
// Pages Subsystem: Binary Assets Sub-Domain
// Self-managed domain schema: PageFile
// ============================================================================

model PageFile {
  id      String  @id @default(uuid(7)) @db.Uuid
  spaceId String  @map("space_id") @db.Uuid
  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_files_space_id")
  pageId  String? @map("page_id") @db.Uuid
  page    Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_files_page_id")

  name       String @db.VarChar(1000)
  mimeType   String @default("application/octet-stream") @map("mime_type") @db.VarChar(128)
  sizeBytes  Int    @default(0) @map("size_bytes")
  hash       String @db.VarChar(64)
  storageKey String @map("storage_key") @db.VarChar(512)
  bucketName String @default("manuscript-files") @map("bucket_name") @db.VarChar(128)
  rev        Int    @default(0)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  node PageNode?

  @@index([spaceId, deletedAt, name], map: "idx_page_files_space_del_name")
  @@index([pageId, deletedAt, name], map: "idx_page_files_page_del_name")
  @@index([spaceId, deletedAt, createdAt(sort: Desc)], map: "idx_page_files_space_del_created")
  @@index([spaceId, deletedAt, updatedAt(sort: Desc)], map: "idx_page_files_space_del_updated")
  @@index([spaceId, hash], map: "idx_page_files_space_hash")
  @@index([hash, deletedAt], map: "idx_page_files_hash_deleted")
  @@index([storageKey], map: "idx_page_files_storage_key")
  @@map("page_files")
}
