// ============================================================================
// Pages Subsystem: Binary Assets Sub-Domain
// Self-managed domain schema: PageFile
// ============================================================================

model PageFile {
  id      String @id @default(uuid(7)) @db.Uuid
  spaceId String @map("space_id") @db.Uuid
  pageId  String @map("page_id") @db.Uuid
  page    Page   @relation(fields: [pageId, spaceId], references: [id, spaceId], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_files_page_space")

  blobId        String?      @map("blob_id") @db.Uuid
  blob          FileBlob?    @relation(fields: [blobId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_page_files_blob_id")
  lastKnownPath String       @map("last_known_path") @db.VarChar(1000)
  mimeType      String       @default("application/octet-stream") @map("mime_type") @db.VarChar(128)
  sizeBytes     Int          @default(0) @map("size_bytes")
  hash          String       @db.VarChar(64)
  storageKey    String       @map("storage_key") @db.VarChar(512)
  bucketName    String       @default("manuscript-files") @map("bucket_name") @db.VarChar(128)
  rev           Int          @default(0)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  node PageNode?

  @@unique([id, pageId], map: "uq_page_files_id_page")
  @@index([pageId, deletedAt, lastKnownPath], map: "idx_page_files_page_del_path")
  @@index([pageId, deletedAt, createdAt(sort: Desc)], map: "idx_page_files_page_del_created")
  @@index([spaceId, deletedAt, createdAt(sort: Desc)], map: "idx_page_files_space_del_created")
  @@index([spaceId, deletedAt, updatedAt(sort: Desc)], map: "idx_page_files_space_del_updated")
  @@index([spaceId, hash], map: "idx_page_files_space_hash")
  @@index([hash, deletedAt], map: "idx_page_files_hash_deleted")
  @@index([blobId], map: "idx_page_files_blob_id")
  @@index([storageKey], map: "idx_page_files_storage_key")
  @@map("page_files")
}
