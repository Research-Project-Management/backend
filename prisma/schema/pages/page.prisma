// ============================================================================
// Pages Subsystem: Page Aggregate Root Sub-Domain
// Self-managed domain schema: Page
// ============================================================================

model Page {
  id          String    @id @default(uuid(7)) @db.Uuid
  spaceId     String    @map("space_id") @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_pages_space_id")
  rootDocId   String?   @map("root_doc_id") @db.Uuid
  rootDoc     PageDoc?  @relation("PageRootDoc", fields: [rootDocId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_pages_root_doc_id")
  title       String    @default("Untitled") @db.VarChar(500)
  description String?   @db.Text
  status      String    @default("draft") @db.VarChar(50) // draft, published, archived

  compiler            String    @default("pdflatex") @db.VarChar(32)
  texLiveVersion      String    @default("2024") @map("tex_live_version") @db.VarChar(16)
  spellCheckLanguage  String    @default("en_US") @map("spell_check_language") @db.VarChar(16)
  pdfThumbnail        String?   @map("pdf_thumbnail") @db.Text
  settings            Json      @default("{}")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations to child entities scoped under this Page
  docs            PageDoc[]
  nodes           PageNode[]
  files           PageFile[]
  snapshots       PageSnapshot[]
  labels          PageSnapshotLabel[]
  trackChanges    PageTrackChange[]
  commentThreads  PageCommentThread[]

  @@index([spaceId, deletedAt, updatedAt(sort: Desc)], map: "idx_pages_space_updated")
  @@index([spaceId, deletedAt, title], map: "idx_pages_space_title")
  @@index([rootDocId], map: "idx_pages_root_doc_id")
  @@map("pages")
}
