// ============================================================================
// Pages Subsystem: History & Snapshots Sub-Domain
// Self-managed domain schema: PageSnapshot, PageSnapshotLabel
// ============================================================================

model PageSnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_snapshots_space_id")
  pageId      String?  @map("page_id") @db.Uuid
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_snapshots_page_id")
  version     Int      @default(1)
  summary     String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  isAutomatic Boolean  @default(false) @map("is_automatic")
  files       Json     @default("{}")
  sizeBytes   Int      @default(0) @map("size_bytes")
  inStorage   Boolean  @default(false) @map("in_storage")
  storageKey  String?  @map("storage_key") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  labels PageSnapshotLabel[]

  @@unique([pageId, version], map: "uq_page_snapshots_page_version")
  @@index([spaceId, version], map: "idx_page_snapshots_space_version")
  @@index([spaceId, createdAt(sort: Desc)], map: "idx_page_snapshots_space_created_desc")
  @@index([pageId, createdAt(sort: Desc)], map: "idx_page_snapshots_page_created_desc")
  @@index([spaceId, inStorage], map: "idx_page_snapshots_storage")
  @@index([pageId, inStorage], map: "idx_page_snapshots_page_storage")
  @@map("page_snapshots")
}

model PageSnapshotLabel {
  id          String       @id @default(uuid(7)) @db.Uuid
  spaceId     String       @map("space_id") @db.Uuid
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_snapshot_labels_space_id")
  pageId      String?      @map("page_id") @db.Uuid
  page        Page?        @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_snapshot_labels_page_id")
  snapshotId  String       @map("snapshot_id") @db.Uuid
  snapshot    PageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, map: "fk_page_snapshot_labels_snapshot_id")
  version     Int
  label       String       @db.VarChar(255)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([pageId, label], map: "uq_page_snapshot_labels_page_label")
  @@index([spaceId, label], map: "idx_page_snapshot_labels_space_label")
  @@index([spaceId, version], map: "idx_page_snapshot_labels_space_version")
  @@index([pageId, version], map: "idx_page_snapshot_labels_page_version")
  @@index([snapshotId], map: "idx_page_snapshot_labels_snapshot_id")
  @@map("page_snapshot_labels")
}
