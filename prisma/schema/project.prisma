// -- 2. Project Context (Collaborative Research Microservice) ----------------

enum ProjectMemberRole {
  owner       // Truong nhom nghien cuu - toan quyen quan ly
  contributor // Thanh vien nghien cuu - tao/sua task, upload paper, viet tai lieu
  commenter   // GVHD / Reviewer - xem + binh luan, khong tao/sua noi dung
  viewer      // Hoi dong phan bien - chi xem (read-only)
}

enum InvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model Project {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  identifier     String                @unique
  description    String?               @default("")
  avatar         String?
  coverImage     String?               @map("cover_image")
  network        String?               @default("secret") // secret, public
  isActive       Boolean               @default(true) @map("is_active")
  createdById    String                @map("created_by_id") @db.Uuid
  createdBy      User                  @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  modules        String[]              @default(["tasks", "cycles", "views", "pages", "stickies", "storage"])
  settings       Json?                 @default("{}")

  // Task & Board extensions
  taskSequence   Int                   @default(0) @map("task_sequence")
  taskColumns    Json?                 @default("[]") @map("task_columns")

  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(6)

  // Relations
  members        ProjectMember[]
  invitations    ProjectInvitation[]
  pages          Page[]
  states         WorkItemState[]
  cycles         Cycle[]
  workItems      WorkItem[]
  labels         Label[]
  views          WorkItemView[]
  userProperties ProjectUserProperty[]
  drafts         WorkItemDraft[]
  templates      WorkItemTemplate[]
  activityEvents ActivityEvent[]
  aiChats        AiChat[]              @relation("ProjectAiChats")
  stickies       Sticky[]              @relation("ProjectStickies")

  // Academic Library Relations (Project Scope & Collaborative Repository)
  items          Item[]                @relation("ProjectItems")
  collections    Collection[]          @relation("ProjectCollections")
  tags           Tag[]                 @relation("ProjectTags")
  notes          Note[]                @relation("ProjectNotes")
  savedSearches  SavedSearch[]         @relation("ProjectSavedSearches")

  @@index([createdById])
  @@index([isActive, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectMemberRole @default(contributor)
  joinedAt  DateTime          @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

model ProjectInvitation {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @map("project_id") @db.Uuid
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  role        ProjectMemberRole @default(contributor)
  tokenHash   String            @unique @map("token_hash")
  status      InvitationStatus  @default(pending)
  invitedById String            @map("invited_by_id") @db.Uuid
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status])
  @@index([email])
  @@map("project_invitations")
}
