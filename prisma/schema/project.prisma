// ── 3. Shared & Storage Context ─────────────────────────────────────────────

model File {
  id           String     @id @default(uuid()) @db.Uuid
  filename     String
  isFolder     Boolean    @default(false) @map("is_folder")
  parentId     String?    @map("parent_id") @db.Uuid
  parent       File?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     File[]     @relation("FolderHierarchy")
  authorId     String     @map("author_id") @db.Uuid
  author       User       @relation("FileAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  workspaceId  String?    @map("workspace_id") @db.Uuid
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedToType String?    @map("linked_to_type")
  linkedToId   String?    @map("linked_to_id")
  starred      Boolean    @default(false)
  trashedAt    DateTime?  @map("trashed_at") @db.Timestamptz(6)
  metaData     Json?      @map("meta_data")
  size         Int?       @default(0)
  mimeType     String?    @default("application/octet-stream") @map("mime_type")
  url          String?
  thumbnail    String?
  uploadedAt   DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  sharedWith  FileShare[]
  attachments Attachment[]

  @@index([workspaceId, parentId, trashedAt])
  @@index([workspaceId, isFolder, trashedAt])
  @@index([linkedToId, linkedToType])
  @@index([authorId, trashedAt])
  @@index([trashedAt])
  @@index([url])
  @@map("files")
}

model FileShare {
  id         String         @id @default(uuid()) @db.Uuid
  fileId     String         @map("file_id") @db.Uuid
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission FilePermission @default(view)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([fileId, userId])
  @@index([userId])
  @@map("file_shares")
}

model Label {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  color       String    @default("#3b82f6")
  description String?
  type        LabelType @default(sticky)
  sortOrder   Float     @default(65535) @map("sort_order")
  parentId    String?   @map("parent_id") @db.Uuid
  parent      Label?    @relation("LabelHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Label[]   @relation("LabelHierarchy")
  projectId   String?   @map("project_id") @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, name, type])
  @@index([projectId, sortOrder])
  @@index([projectId, parentId])
  @@map("labels")
}


// ── 5. Manuscript Context (Authoring & LaTeX) ───────────────────────────────

model Page {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  slug           String?    @map("slug")
  icon           String?    @map("icon")
  coverImage     String?    @map("cover_image")
  content        Json? // Editor JSON block content or LaTeX source
  status         PageStatus @default(draft)
  rank           Float      @default(0)
  isLocked       Boolean    @default(false) @map("is_locked")
  isPublished    Boolean    @default(false) @map("is_published")
  views          Int        @default(0)
  lastAccessedAt DateTime   @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  workspaceId    String     @map("workspace_id") @db.Uuid
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String     @map("project_id") @db.Uuid
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String     @map("author_id") @db.Uuid
  author         User       @relation("PageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parentPageId   String?    @map("parent_page_id") @db.Uuid
  parentPage     Page?      @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: Cascade)
  childPages     Page[]     @relation("PageHierarchy")
  mainFileId     String?    @map("main_file_id") @db.Uuid
  mainFile       Page?      @relation("PageMainFile", fields: [mainFileId], references: [id], onDelete: SetNull)
  mainFileOf     Page[]     @relation("PageMainFile")
  pdfThumbnail   String?    @map("pdf_thumbnail")
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  versions PageVersion[]
  comments PageComment[]

  @@index([projectId, parentPageId, rank])
  @@index([projectId, status, deletedAt])
  @@index([workspaceId, projectId, deletedAt])
  @@index([workspaceId, deletedAt, updatedAt(sort: Desc)])
  @@index([parentPageId, deletedAt])
  @@index([authorId])
  @@index([deletedAt])
  @@map("pages")
}

model PageVersion {
  id            String           @id @default(uuid()) @db.Uuid
  pageId        String           @map("page_id") @db.Uuid
  page          Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectPageId String?          @map("project_page_id") @db.Uuid
  content       String?          @default("")
  title         String?          @default("")
  label         String?          @default("")
  savedById     String?          @map("saved_by_id") @db.Uuid
  eventType     VersionEventType @default(manual_save) @map("event_type")
  fileName      String?          @default("") @map("file_name")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([pageId, createdAt])
  @@index([projectPageId])
  @@map("page_versions")
}

// ── 6. Planning Context (Tasks & Cycles) ────────────────────────────────────

model Task {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  content        String?        @default("")
  columnId       String         @map("column_id")
  startDate      DateTime?      @map("start_date") @db.Timestamptz(6)
  dueDate        DateTime?      @map("due_date") @db.Timestamptz(6)
  labels         String[]       @default([])
  rank           Float          @default(0)
  priority       TaskPriority   @default(none)
  relations      Json?          @default("[]")
  identifier     String?        @map("identifier")
  sequenceNumber Int?           @map("sequence_number")
  timeSpent      Float?         @default(0) @map("time_spent")
  completed      Boolean        @default(false)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(6)
  projectId      String         @map("project_id") @db.Uuid
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String         @map("author_id") @db.Uuid
  author         User           @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assigneeId     String?        @map("assignee_id") @db.Uuid
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Additional co-assignees stored as JSON array of user IDs.
  /// Primary assignee is always mirrored in assigneeId for backward compat.
  assigneeIds    Json           @default("[]") @map("assignee_ids")
  cycleId        String?        @map("cycle_id") @db.Uuid
  cycle          Cycle?         @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  parentTaskId   String?        @map("parent_task_id") @db.Uuid
  parentTask     Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]         @relation("TaskSubtasks")
  /// Status update signals (On Track / At Risk / Off Track). Stored as JSON array, newest first.
  updates        Json           @default("[]")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  // Relations
  comments    TaskComment[]
  worklogs    Worklog[]

  @@index([projectId, columnId, rank])
  @@index([projectId, columnId, deletedAt, rank])
  @@index([projectId, parentTaskId, rank])
  @@index([projectId, completed, deletedAt])
  @@index([projectId, assigneeId, dueDate])
  @@index([projectId, assigneeId, deletedAt])
  @@index([projectId, priority, deletedAt])
  @@index([projectId, identifier])
  @@index([projectId, cycleId, deletedAt])
  @@index([cycleId, deletedAt])
  @@index([deletedAt])
  @@map("tasks")
}

model Cycle {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  description       String?     @default("")
  startDate         DateTime?   @map("start_date") @db.Timestamptz(6)
  endDate           DateTime?   @map("end_date") @db.Timestamptz(6)
  status            CycleStatus @default(planned)
  phase             CyclePhase  @default(custom)
  milestones        Json?       @default("[]")
  deliverables      Json?       @default("[]")
  labels            String[]    @default([])
  order             Int         @default(0)
  startedAt         DateTime?   @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?   @map("ended_at") @db.Timestamptz(6)
  statsAtCompletion Json?       @default("{\"totalTasks\":0,\"completedTasks\":0,\"completionPercentage\":0}") @map("stats_at_completion")
  projectId         String      @map("project_id") @db.Uuid
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId          String      @map("author_id") @db.Uuid
  author            User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  // Relations
  tasks Task[]

  @@index([projectId, status, deletedAt])
  @@index([projectId, order])
  @@index([deletedAt])
  @@map("cycles")
}

model Worklog {
  id          String   @id @default(uuid()) @db.Uuid
  hours       Float
  description String   @default("")
  date        DateTime @default(now()) @db.Timestamptz(6)
  taskId      String?  @map("task_id") @db.Uuid
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId   String   @map("project_id") @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation("UserWorklogs", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, date])
  @@index([userId, date])
  @@index([projectId, userId, date])
  @@index([taskId])
  @@index([taskId, date])
  @@map("worklogs")
}

// ── 7. Collaboration Context (Comments & Stickies) ──────────────────────────

model PageComment {
  id            String        @id @default(uuid()) @db.Uuid
  pageId        String        @map("page_id") @db.Uuid
  page          Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectPageId String?       @map("project_page_id") @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  isEdited      Boolean       @default(false) @map("is_edited")
  line          Int?
  lineEnd       Int?          @map("line_end")
  status        CommentStatus @default(open)
  replies       Json?         @default("[]")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([pageId, status])
  @@index([authorId])
  @@map("page_comments")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isEdited  Boolean  @default(false) @map("is_edited")
  reactions   Json?    @default("[]")
  replies     Json?    @default("[]")
  attachments Json?    @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

model Sticky {
  id          String      @id @default(uuid()) @db.Uuid
  title       String?     @default("")
  content     String
  color       String      @default("yellow-1")
  scope       StickyScope @default(workspace)
  positionX   Float       @default(0) @map("position_x")
  positionY   Float       @default(0) @map("position_y")
  order       Int         @default(0)
  workspaceId String      @map("workspace_id") @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?     @map("project_id") @db.Uuid
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, userId, scope, order])
  @@index([projectId, userId, scope, order])
  @@index([userId])
  @@map("stickies")
}

// ── 8. Saved Views Context (Plane.so parity) ────────────────────────────────

enum ViewAccess {
  public
  private
}

model WorkItemView {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  description       String?        @default("")
  query             Json           @default("{}")
  filters           Json?          @default("{}")
  displayFilters    Json?          @default("{}") @map("display_filters")
  displayProperties Json?          @default("{}") @map("display_properties")
  richFilters       Json?          @default("{}") @map("rich_filters")
  access            ViewAccess     @default(public)
  sortOrder         Float          @default(65535) @map("sort_order")
  logoProps         Json?          @default("{}") @map("logo_props")
  isLocked          Boolean        @default(false) @map("is_locked")
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  projectId         String         @map("project_id") @db.Uuid
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById       String         @map("created_by_id") @db.Uuid
  createdBy         User           @relation("ViewAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  favorites         ViewFavorite[]
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, access])
  @@index([projectId, createdById])
  @@map("work_item_views")
}

model ViewFavorite {
  id        String       @id @default(uuid()) @db.Uuid
  viewId    String       @map("view_id") @db.Uuid
  view      WorkItemView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([viewId, userId])
  @@index([userId])
  @@map("view_favorites")
}

model ProjectUserProperty {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters           Json      @default("{}")
  displayFilters    Json      @default("{}") @map("display_filters")
  displayProperties Json      @default("{}") @map("display_properties")
  richFilters       Json      @default("{}") @map("rich_filters")
  preferences       Json      @default("{}")
  sortOrder         Float     @default(65535) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_user_properties")
}

// ── 9. Universal Entity Attachment Context ───────────────────────────────────

model EntityAttachment {
  id          String     @id @default(uuid()) @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id")
  workspaceId String?    @map("workspace_id") @db.Uuid
  projectId   String?    @map("project_id") @db.Uuid
  filename    String
  url         String
  storageKey  String?    @map("storage_key")
  size        Int        @default(0)
  mimeType    String     @default("application/octet-stream") @map("mime_type")
  metadata    Json?      @default("{}")
  authorId    String?    @map("author_id") @db.Uuid
  author      User?      @relation("UserAttachments", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt], map: "idx_entity_attachments_entity")
  @@index([workspaceId, createdAt], map: "idx_entity_attachments_workspace")
  @@index([projectId, createdAt], map: "idx_entity_attachments_project")
  @@index([authorId], map: "idx_entity_attachments_author")
  @@map("entity_attachments")
}

// ── 10. Work Item Drafts Context (Plane.so parity) ───────────────────────────

model WorkItemDraft {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @default("")
  content     String?       @default("")
  description String?       @default("")
  columnId    String?       @map("column_id")
  priority    TaskPriority  @default(none)
  startDate   DateTime?     @map("start_date") @db.Timestamptz(6)
  dueDate     DateTime?     @map("due_date") @db.Timestamptz(6)
  labels      String[]      @default([])
  assigneeId  String?       @map("assignee_id") @db.Uuid
  assigneeIds Json          @default("[]") @map("assignee_ids")
  metadata    Json?         @default("{}")
  projectId   String?       @map("project_id") @db.Uuid
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String        @map("author_id") @db.Uuid
  author      User          @relation("UserDrafts", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authorId, createdAt])
  @@index([projectId, authorId])
  @@map("work_item_drafts")
}

// ── 11. Work Item Templates Context (Plane.so parity) ─────────────────────────

model WorkItemTemplate {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?       @default("")
  title       String?       @default("")
  content     String?       @default("")
  priority    TaskPriority  @default(none)
  labels      String[]      @default([])
  labelIds    Json          @default("[]") @map("label_ids")
  assigneeIds Json          @default("[]") @map("assignee_ids")
  checklists  Json          @default("[]")
  isDefault   Boolean       @default(false) @map("is_default")
  projectId   String        @map("project_id") @db.Uuid
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String        @map("author_id") @db.Uuid
  author      User          @relation("UserTemplates", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@index([projectId, isDefault])
  @@index([projectId, deletedAt])
  @@index([authorId])
  @@map("work_item_templates")
}

