// -- 5. AI & Intelligence Context (Space-Scoped AI Microservice) --------------

enum MessageRole {
  user
  assistant
  system
}

model AiChat {
  id            String   @id @default(uuid(7)) @db.Uuid
  spaceId       String   @map("space_id") @db.Uuid
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById   String   @map("created_by_id") @db.Uuid
  createdBy     User     @relation("UserAiChats", fields: [createdById], references: [id], onDelete: Cascade)
  pageId        String?  @map("page_id") @db.Uuid
  title         String   @default("New Chat")
  summary       String?  @default("")
  keyFacts      String[] @default([]) @map("key_facts")
  openQuestions String[] @default([]) @map("open_questions")
  documentIds   String[] @default([]) @map("document_ids")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages AiMessage[]

  @@index([spaceId, updatedAt(sort: Desc)])
  @@index([createdById, updatedAt(sort: Desc)])
  @@index([pageId, spaceId])
  @@map("ai_chats")
}

model AiMessage {
  id               String      @id @default(uuid(7)) @db.Uuid
  chatId           String      @map("chat_id") @db.Uuid
  chat             AiChat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String      @default("")
  sources          Json?       @default("[]")
  widgets          Json?       @default("[]")
  selectionContext Json?       @map("selection_context")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([chatId, createdAt])
  @@map("ai_messages")
}
