// -- 9. Document, Wiki & LaTeX Manuscript Context (Document Microservice) -----------

enum PageStatus {
  draft
  published
  archived
}

enum VersionEventType {
  manual_save
  auto_save
  restore
  collaborative_checkpoint
}

enum CommentStatus {
  open
  resolved
}

enum SuggestionStatus {
  pending
  accepted
  rejected
}

model Page {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  slug           String?       @map("slug")
  icon           String?       @map("icon")
  coverImage     String?       @map("cover_image")
  content        Json?         @default("{}")
  status         PageStatus    @default(draft)
  rank           Float         @default(0)
  isLocked       Boolean       @default(false) @map("is_locked")
  isPublished    Boolean       @default(false) @map("is_published")
  views          Int           @default(0)
  lastAccessedAt DateTime      @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  projectId      String        @map("project_id") @db.Uuid
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String        @map("author_id") @db.Uuid
  author         User          @relation("PageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentPageId   String?       @map("parent_page_id") @db.Uuid
  parentPage     Page?         @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: Cascade)
  childPages     Page[]        @relation("PageHierarchy")
  mainFileId     String?       @map("main_file_id") @db.Uuid
  mainFile       Page?         @relation("PageMainFile", fields: [mainFileId], references: [id], onDelete: SetNull)
  mainFileOf     Page[]        @relation("PageMainFile")
  pdfThumbnail   String?       @map("pdf_thumbnail")
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  versions         PageVersion[]
  comments         PageComment[]
  suggestions      PageSuggestion[]
  aiChats          AiChat[]              @relation("PageAiChats")
  labelAssignments PageLabelAssignment[]

  @@index([projectId, parentPageId, rank])
  @@index([projectId, status, deletedAt])
  @@index([parentPageId, deletedAt])
  @@index([authorId])
  @@index([deletedAt])
  @@map("pages")
}

model PageVersion {
  id            String           @id @default(uuid()) @db.Uuid
  pageId        String           @map("page_id") @db.Uuid
  page          Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectPageId String?          @map("project_page_id") @db.Uuid
  content       String?          @default("")
  title         String?          @default("")
  label         String?          @default("")
  savedById     String?          @map("saved_by_id") @db.Uuid
  eventType     VersionEventType @default(manual_save) @map("event_type")
  fileName      String?          @default("") @map("file_name")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([pageId, createdAt])
  @@index([projectPageId])
  @@map("page_versions")
}

model PageComment {
  id             String        @id @default(uuid()) @db.Uuid
  pageId         String        @map("page_id") @db.Uuid
  page           Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectPageId  String?       @map("project_page_id") @db.Uuid
  authorId       String        @map("author_id") @db.Uuid
  author         User          @relation("PageCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  isEdited       Boolean       @default(false) @map("is_edited")
  line           Int?
  lineEnd        Int?          @map("line_end")
  status         CommentStatus @default(open)
  replies        Json?         @default("[]")
  /// JSON-encoded Y.RelativePosition for start of highlighted range.
  /// Stays accurate after concurrent edits without manual range tracking.
  yjsAnchorStart String?       @map("yjs_anchor_start")
  /// JSON-encoded Y.RelativePosition for end of highlighted range.
  yjsAnchorEnd   String?       @map("yjs_anchor_end")
  /// Snapshot of the highlighted text at comment creation time (for display context).
  selectedText   String?       @map("selected_text")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@index([pageId, status])
  @@index([projectPageId])
  @@index([authorId])
  @@map("page_comments")
}


model PageSuggestion {
  id            String           @id @default(uuid()) @db.Uuid
  pageId        String           @map("page_id") @db.Uuid
  page          Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectPageId String?          @map("project_page_id") @db.Uuid
  authorId      String           @map("author_id") @db.Uuid
  author        User             @relation("PageSuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  type          String           @default("replace") // 'insert' | 'delete' | 'replace'
  originalText  String           @default("") @map("original_text")
  suggestedText String           @default("") @map("suggested_text")
  fromLine      Int              @map("from_line")
  fromColumn    Int              @default(1) @map("from_column")
  toLine        Int              @map("to_line")
  toColumn      Int              @default(1) @map("to_column")
  description   String?          @default("")
  status        SuggestionStatus @default(pending)
  resolvedById  String?          @map("resolved_by_id") @db.Uuid
  resolvedAt    DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@index([pageId, status])
  @@index([projectPageId])
  @@index([authorId])
  @@map("page_suggestions")
}

// Assigns a WorkItemLabel (project-scoped, with color) to a Page
// Shares the same label pool as Work Items within the same project
model PageLabelAssignment {
  pageId     String   @map("page_id") @db.Uuid
  labelId    String   @map("label_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  page  Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label WorkItemLabel @relation("PageLabelAssignments", fields: [labelId], references: [id], onDelete: Cascade)

  @@id([pageId, labelId], map: "pk_page_label_assignments")
  @@index([labelId, pageId], map: "idx_page_label_assignments_covering")
  @@map("page_label_assignments")
}
