// -- 3. Storage & Asset Bounded Context (Unified Space Storage Platform) ------

enum FilePermission {
  view
  edit
}

enum BlobStatus {
  PENDING
  READY
  DELETED
}

enum UploadSessionStatus {
  INITIALIZED
  UPLOADING
  COMPLETED
  ABORTED
  EXPIRED
}

// -------------------------
// Logical File Node (Space-Scoped: Personal Space vs Project Space)
// -------------------------

model StorageFile {
  id          String @id @default(uuid(7)) @db.Uuid
  spaceId     String @map("space_id") @db.Uuid
  space       Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("UserFiles", fields: [createdById], references: [id], onDelete: Restrict)

  filename String
  size     BigInt        @default(0)
  mimeType String        @default("application/octet-stream") @map("mime_type")
  isFolder Boolean       @default(false) @map("is_folder")
  metadata Json?         @default("{}") @map("metadata") @db.JsonB
  parentId String?       @map("parent_id") @db.Uuid
  parent   StorageFile?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children StorageFile[] @relation("FolderHierarchy")

  // Optional Entity Link (e.g. 'page' | 'library' | 'paper' | 'experiment')
  linkedToType String? @map("linked_to_type")
  linkedToId   String? @map("linked_to_id")

  // CAS Physical Blob Link
  blobId String?      @map("blob_id") @db.Uuid
  blob   StorageBlob? @relation(fields: [blobId], references: [id], onDelete: Restrict)

  stars      StorageFileStar[]
  sharedWith StorageFileShare[]
  versions   StorageFileVersion[]

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId, parentId, deletedAt, isFolder(sort: Desc), filename])
  @@index([spaceId, deletedAt, updatedAt(sort: Desc)])
  @@index([createdById])
  @@index([parentId, deletedAt])
  @@index([linkedToType, linkedToId, parentId, deletedAt, isFolder(sort: Desc), filename])
  @@index([deletedAt])
  @@index([blobId])
  @@map("storage_files")
}

model StorageFileStar {
  fileId    String      @map("file_id") @db.Uuid
  file      StorageFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation("UserStarredFiles", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([fileId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("storage_file_stars")
}

model StorageFileShare {
  id         String         @id @default(uuid(7)) @db.Uuid
  fileId     String         @map("file_id") @db.Uuid
  file       StorageFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation("UserSharedFiles", fields: [userId], references: [id], onDelete: Cascade)
  permission FilePermission @default(view)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([fileId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("storage_file_shares")
}

// -------------------------
// Physical Storage Blob (CAS - Content-Addressable Storage)
// -------------------------

model StorageBlob {
  id            String     @id @default(uuid(7)) @db.Uuid
  contentHash   Bytes      @map("content_hash")
  hashAlgorithm String     @default("SHA256") @map("hash_algorithm") @db.VarChar(16)
  sizeBytes     BigInt     @map("size_bytes")
  s3Key         String     @map("s3_key") @db.VarChar(512)
  s3Bucket      String     @map("s3_bucket") @db.VarChar(63)
  storageClass  String     @default("STANDARD") @map("storage_class") @db.VarChar(32)
  refCount      Int        @default(1) @map("ref_count")
  status        BlobStatus @default(PENDING)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  tombstoneAt   DateTime?  @map("tombstone_at") @db.Timestamptz(6)

  files    StorageFile[]
  versions StorageFileVersion[]

  @@unique([contentHash], map: "uq_blobs_content_hash")
  @@index([refCount, tombstoneAt], map: "idx_blobs_orphan_gc")
  @@index([tombstoneAt], map: "idx_blobs_tombstone")
  @@index([status], map: "idx_blobs_status")
  @@map("storage_blobs")
}

// -------------------------
// File Revisions / Versioning (Scientific Reproducibility)
// -------------------------

model StorageFileVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  fileId        String   @map("file_id") @db.Uuid
  blobId        String   @map("blob_id") @db.Uuid
  versionNumber Int      @map("version_number")
  sizeBytes     BigInt?  @map("size_bytes")
  mimeType      String?  @map("mime_type") @db.VarChar(150)
  changeComment String?  @map("change_comment") @db.VarChar(500)
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file StorageFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  blob StorageBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@unique([fileId, versionNumber], map: "uq_storage_file_version")
  @@index([blobId], map: "idx_storage_file_version_blob_fk")
  @@index([createdById], map: "idx_storage_file_version_created_by")
  @@map("storage_file_versions")
}

// -------------------------
// S3 Multipart Upload Sessions
// -------------------------

model UploadSession {
  id           String              @id @default(uuid(7)) @db.Uuid
  spaceId      String              @map("space_id") @db.Uuid
  space        Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById  String              @map("created_by_id") @db.Uuid
  s3UploadId   String              @map("s3_upload_id") @db.VarChar(1024)
  s3Key        String              @map("s3_key") @db.VarChar(512)
  filename     String              @db.VarChar(255)
  mimeType     String              @default("application/octet-stream") @map("mime_type") @db.VarChar(127)
  totalSize    BigInt              @map("total_size")
  partSize     Int                 @map("part_size")
  totalParts   Int                 @map("total_parts")
  expectedHash Bytes?              @map("expected_hash")
  parentId     String?             @map("parent_id") @db.Uuid
  status       UploadSessionStatus @default(INITIALIZED)
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, expiresAt], map: "idx_upload_sessions_cleanup")
  @@index([spaceId], map: "idx_upload_sessions_space")
  @@index([createdById], map: "idx_upload_sessions_creator")
  @@index([parentId], map: "idx_upload_sessions_parent")
  @@map("upload_sessions")
}

// -------------------------
// Space Quota Ledger (1 Quota per Space)
// -------------------------

model StorageQuota {
  id        String   @id @default(uuid(7)) @db.Uuid
  spaceId   String   @unique(map: "uq_storage_quotas_space_id") @map("space_id") @db.Uuid
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  usedBytes BigInt   @default(0) @map("used_bytes")
  maxBytes  BigInt   @map("max_bytes")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("storage_quotas")
}
