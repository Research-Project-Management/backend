// -- 1. IAM Bounded Context (Identity & Access Management Microservice) ------

enum UserStatus {
  active
  suspended
  pending_verification
  deactivated
}

enum AuthProvider {
  google
  github
  orcid
  saml
  local
}

enum SecurityEventType {
  login_success
  login_failed
  logout
  token_refreshed
  token_revoked
  token_breach_detected
  password_reset_requested
  password_reset_completed
  oauth_account_linked
  oauth_account_unlinked
  mfa_enabled
  mfa_disabled
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  email      String?    @unique
  password   String?
  name       String     @default("User")
  avatar     String?
  isVerified Boolean    @default(false) @map("is_verified")
  status     UserStatus @default(active)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Backward compatibility OAuth IDs
  googleId   String?    @unique @map("google_id")
  githubId   String?    @unique @map("github_id")

  // IAM Internal Relations (100% Isolated)
  federatedIdentities FederatedIdentity[]
  refreshTokens       RefreshToken[]
  securityAuditLogs   SecurityAuditLog[]    @relation("AuditActor")
  settings            UserSettings?

  // Collaborative Project Relations (Clean & Two-Tier)
  createdProjects     Project[]             @relation("ProjectCreator")
  projectMembers      ProjectMember[]       @relation("UserProjectMemberships")

  // Storage Relations (Personal Scope & File Sharing)
  authoredFiles       File[]                @relation("UserFiles")
  sharedFiles         FileShare[]           @relation("UserSharedFiles")

  // Work-Item Relations (Collaborative Issue Tracking)
  authoredCycles      Cycle[]
  userActivityEvents  ActivityEvent[]       @relation("UserActivityEvents")
  createdWorkItems    WorkItem[]            @relation("WorkItemAuthor")
  assignedWorkItems   WorkItem[]            @relation("WorkItemAssignee")
  workItemComments    WorkItemComment[]
  createdViews        WorkItemView[]        @relation("ViewAuthor")
  viewFavorites       ViewFavorite[]
  userProperties      ProjectUserProperty[]
  userDrafts          WorkItemDraft[]       @relation("UserDrafts")
  userTemplates       WorkItemTemplate[]    @relation("UserTemplates")
  userAttachments     EntityAttachment[]    @relation("UserAttachments")
  createdLabels       Label[]               @relation("UserCreatedLabels")

  // AI & Intelligence Relations (Unified Copilot & Chat History)
  aiChats             AiChat[]              @relation("UserAiChats")

  // Sticky Notes & Canvas Relations
  stickies            Sticky[]              @relation("UserStickies")

  // Academic Library Relations (Personal Scope & Curation)
  items               Item[]                @relation("UserItems")
  collections         Collection[]          @relation("UserCollections")
  tags                Tag[]                 @relation("UserTags")
  annotations         Annotation[]          @relation("UserAnnotations")
  notes               Note[]                @relation("UserNotes")
  itemStates          State[]               @relation("UserItemStates")
  savedSearches       SavedSearch[]         @relation("UserSavedSearches")
  zoteroConnections   ZoteroConnection[]
  capturePreviews     CapturePreview[]

  // Document Relations (Page & Document Collaboration)
  authoredPages        Page[]                @relation("PageAuthor")
  authoredPageComments PageComment[]         @relation("PageCommentAuthor")

  @@index([email])
  @@index([status, deletedAt])
  @@map("users")
}

model UserSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           String   @default("system")
  citationStyle   String   @default("apa") @map("citation_style")
  locale          String   @default("en")
  editorConfig    Json     @default("{}") @map("editor_config")
  notifications   Json     @default("{}")
  aiPreferences   Json     @default("{}") @map("ai_preferences")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_settings")
}

model FederatedIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id")
  email             String?
  profileData       Json?        @map("profile_data")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerSubjectId])
  @@unique([userId, provider])
  @@index([userId])
  @@index([email])
  @@map("federated_identities")
}

model RefreshToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  tokenHash  String         @unique @default("") @map("token_hash")
  familyId   String         @default(uuid()) @map("family_id") @db.Uuid
  parentId   String?        @map("parent_id") @db.Uuid
  parent     RefreshToken?  @relation("TokenLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children   RefreshToken[] @relation("TokenLineage")
  isRevoked  Boolean        @default(false) @map("is_revoked")
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  userAgent  String?        @map("user_agent")
  ipAddress  String?        @map("ip_address")
  deviceType String?        @map("device_type")
  lastUsedAt DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, isRevoked, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model SecurityAuditLog {
  id         String            @id @default(uuid()) @db.Uuid
  actorId    String?           @map("actor_id") @db.Uuid
  actor      User?             @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType  SecurityEventType @map("event_type")
  targetType String?           @map("target_type")
  targetId   String?           @map("target_id")
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  metadata   Json?
  occurredAt DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("security_audit_logs")
}
