// -- 1. IAM Bounded Context (Identity & Access Management Microservice) ------

enum UserStatus {
  active
  suspended
  pending_verification
  deactivated
}

enum AuthProvider {
  google
  github
  orcid
  saml
  local
}

enum SecurityEventType {
  login_success
  login_failed
  logout
  token_refreshed
  token_revoked
  token_breach_detected
  password_reset_requested
  password_reset_completed
  oauth_account_linked
  oauth_account_unlinked
  email_verification_requested
  email_verified
  account_deactivated
  mfa_enabled
  mfa_disabled
}

enum VerificationTokenType {
  email_verification
  password_reset
}

enum ThemePreference {
  light
  dark
  system
}

enum CitationStyle {
  apa
  mla
  chicago
  harvard
  ieee
  vancouver
  bibtex
}

model User {
  id         String     @id @default(uuid(7)) @db.Uuid
  email      String     @unique
  password   String?    @map("password_hash")
  status     UserStatus @default(pending_verification)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // IAM Internal Relations (100% Isolated)
  profile             UserProfile?
  settings            UserSettings?
  accounts            UserAccount[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  auditLogs           AuditLog[]            @relation("AuditActor")

  // Collaborative Project Relations (Clean & Two-Tier)
  createdProjects     Project[]             @relation("ProjectCreator")
  projectMembers      ProjectMember[]       @relation("UserProjectMemberships")
  projectFavorites    ProjectFavorite[]     @relation("UserProjectFavorites")
  projectLabels       ProjectLabel[]        @relation("UserProjectLabels")
  projectTemplates    ProjectTemplate[]     @relation("UserProjectTemplates")
  projectLinks        ProjectLink[]         @relation("UserProjectLinks")
  projectUpdates      ProjectUpdate[]       @relation("UserProjectUpdates")

  // Storage Relations (Personal Scope & File Sharing)
  authoredFiles       File[]                @relation("UserFiles")
  sharedFiles         FileShare[]           @relation("UserSharedFiles")

  // Work-Item Relations (Collaborative Issue Tracking)
  authoredCycles      Cycle[]
  userActivityEvents  ActivityEvent[]       @relation("UserActivityEvents")
  createdWorkItems    WorkItem[]            @relation("WorkItemAuthor")
  assignedWorkItems   WorkItem[]            @relation("WorkItemAssignee")
  workItemComments    WorkItemComment[]
  createdViews        WorkItemView[]        @relation("ViewAuthor")
  viewFavorites       ViewFavorite[]
  userProperties      ProjectUserProperty[]
  userDrafts          WorkItemDraft[]       @relation("UserDrafts")
  userTemplates       WorkItemTemplate[]    @relation("UserTemplates")
  userAttachments     EntityAttachment[]    @relation("UserAttachments")
  createdLabels       Label[]               @relation("UserCreatedLabels")
  workItemCoAssignments WorkItemAssignee[]  @relation("WorkItemCoAssignees")

  // AI & Intelligence Relations (Unified Copilot & Chat History)
  aiChats             AiChat[]              @relation("UserAiChats")

  // Sticky Notes & Canvas Relations
  stickies            Sticky[]              @relation("UserStickies")


  // Document Relations (Page & Document Collaboration)
  authoredPages           Page[]           @relation("PageAuthor")
  authoredPageComments    PageComment[]    @relation("PageCommentAuthor")
  authoredPageSuggestions PageSuggestion[] @relation("PageSuggestionAuthor")

  @@index([email])
  @@index([status, deletedAt])
  @@map("users")
}

model UserProfile {
  userId         String    @id @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String    @default("User")
  avatar         String?   @map("avatar_url")
  bio            String?   @default("")
  institution    String?
  department     String?
  academicTitle  String?   @map("academic_title")
  orcidId        String?   @map("orcid_id")
  website        String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@index([institution])
  @@map("user_profiles")
}

model UserSettings {
  userId          String          @id @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           ThemePreference @default(system)
  citationStyle   CitationStyle   @default(apa) @map("citation_style")
  locale          String          @default("en")
  editorConfig    Json            @default("{}") @map("editor_config")
  notifications   Json            @default("{}")
  aiPreferences   Json            @default("{}") @map("ai_preferences")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_settings")
}

model UserAccount {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id")
  email             String?
  profileData       Json?        @map("profile_data")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerSubjectId])
  @@unique([userId, provider])
  @@index([email])
  @@map("user_accounts")
}

model RefreshToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique @map("token_hash")
  familyId   String         @default(uuid(7)) @map("family_id") @db.Uuid
  parentId   String?        @map("parent_id") @db.Uuid
  parent     RefreshToken?  @relation("TokenLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children   RefreshToken[] @relation("TokenLineage")
  isRevoked  Boolean        @default(false) @map("is_revoked")
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  userAgent  String?        @map("user_agent")
  ipAddress  String?        @map("ip_address")
  deviceType String?        @map("device_type")
  lastUsedAt DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([familyId])
  @@index([userId, isRevoked, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String            @id @default(uuid(7)) @db.Uuid
  actorId    String?           @map("actor_id") @db.Uuid
  actor      User?             @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType  SecurityEventType @map("event_type")
  targetType String?           @map("target_type")
  targetId   String?           @map("target_id")
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  metadata   Json?
  occurredAt DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("audit_logs")
}

model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique @map("token_hash")
  type      VerificationTokenType @default(email_verification)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type])
  @@map("verification_tokens")
}

