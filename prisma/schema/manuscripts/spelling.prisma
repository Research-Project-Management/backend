// ============================================================================
// Manuscripts Subsystem: Spelling & Custom Dictionaries Sub-Domain
// Self-managed domain schema: ManuscriptCustomWord
// ============================================================================

enum ManuscriptDictionaryScope {
  project
  user
}

model ManuscriptCustomWord {
  id        String                    @id @default(uuid(7)) @db.Uuid
  scope     ManuscriptDictionaryScope
  projectId String?                   @map("project_id") @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_custom_words_project_id")
  userId    String?                   @map("user_id") @db.Uuid
  word      String                    @db.VarChar(128)
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, word], map: "idx_custom_word_project")
  @@index([userId, word], map: "idx_custom_word_user")
  @@unique([scope, projectId, userId, word], map: "uq_custom_word_scoped")
  @@map("manuscript_custom_words")
}
