// ============================================================================
// Manuscripts Subsystem: Project History & Snapshots Sub-Domain
// Self-managed domain schema: ManuscriptSnapshot, ManuscriptLabel
// ============================================================================

model ManuscriptSnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_history_project_id")
  pageId      String?  @map("page_id") @db.Uuid
  page        ManuscriptPage? @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_snapshots_page_id")
  version     Int      @default(1)
  summary     String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  isAutomatic Boolean  @default(false) @map("is_automatic")
  files       Json     @default("{}")
  sizeBytes   Int      @default(0) @map("size_bytes")
  inStorage   Boolean  @default(false) @map("in_storage")
  storageKey  String?  @map("storage_key") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  labels ManuscriptLabel[]

  @@unique([projectId, version], map: "uq_manuscript_snapshots_project_version")
  @@index([pageId, version], map: "idx_manuscript_snapshots_page_version")
  @@index([projectId, createdAt(sort: Desc)], map: "idx_manuscript_snapshots_project_created_desc")
  @@index([pageId, createdAt(sort: Desc)], map: "idx_manuscript_snapshots_page_created_desc")
  @@index([projectId, inStorage], map: "idx_manuscript_snapshots_storage")
  @@map("manuscript_snapshots")
}

model ManuscriptLabel {
  id          String             @id @default(uuid(7)) @db.Uuid
  projectId   String             @map("project_id") @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_history_project_id")
  pageId      String?            @map("page_id") @db.Uuid
  page        ManuscriptPage?    @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_labels_page_id")
  snapshotId  String             @map("snapshot_id") @db.Uuid
  snapshot    ManuscriptSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, map: "fk_manuscript_labels_snapshot_id")
  version     Int
  label       String             @db.VarChar(255)
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, label], map: "uq_manuscript_labels_project_label")
  @@index([pageId, label], map: "idx_manuscript_labels_page_label")
  @@index([projectId, version], map: "idx_manuscript_labels_project_version")
  @@index([pageId, version], map: "idx_manuscript_labels_page_version")
  @@index([snapshotId], map: "idx_manuscript_labels_snapshot_id")
  @@map("manuscript_labels")
}
