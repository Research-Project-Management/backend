// ============================================================================
// Manuscripts Subsystem: File Tree & Hierarchy Sub-Domain
// Self-managed domain schema: ManuscriptNode
// ============================================================================

enum ManuscriptNodeType {
  FOLDER
  DOC
  FILE
}

model ManuscriptNode {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_nodes_project_id")
  pageId    String? @map("page_id") @db.Uuid
  page      ManuscriptPage? @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_nodes_page_id")

  parentId String?          @map("parent_id") @db.Uuid
  parent   ManuscriptNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_nodes_parent_id")
  children ManuscriptNode[] @relation("NodeHierarchy")

  type  ManuscriptNodeType
  name  String             @db.VarChar(255)
  path  String             @db.VarChar(1000)
  depth Int                @default(0)

  docId  String?         @unique(map: "uq_manuscript_nodes_doc_id") @map("doc_id") @db.Uuid
  doc    ManuscriptDoc?  @relation(fields: [docId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_nodes_doc_id")
  fileId String?         @unique(map: "uq_manuscript_nodes_file_id") @map("file_id") @db.Uuid
  file   ManuscriptFile? @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_manuscript_nodes_file_id")
  linkedFile ManuscriptLinkedFile?

  isRootDoc Boolean @default(false) @map("is_root_doc")
  sizeBytes Int     @default(0) @map("size_bytes")
  hash      String? @db.VarChar(64)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, path], map: "uq_manuscript_nodes_project_path")
  @@unique([pageId, path], map: "uq_manuscript_nodes_page_path")
  @@index([projectId, parentId, name], map: "idx_manuscript_nodes_parent_name")
  @@index([pageId, parentId, name], map: "idx_manuscript_nodes_page_parent_name")
  @@index([projectId, depth, sortOrder, name], map: "idx_manuscript_nodes_project_tree")
  @@index([pageId, depth, sortOrder, name], map: "idx_manuscript_nodes_page_tree")
  @@index([projectId, type, isRootDoc(sort: Desc), sortOrder], map: "idx_manuscript_nodes_proj_type_root_sort")
  @@index([pageId, type, isRootDoc(sort: Desc), sortOrder], map: "idx_manuscript_nodes_page_type_root_sort")
  @@index([projectId, isRootDoc], map: "idx_manuscript_nodes_project_root")
  @@map("manuscript_nodes")
}
