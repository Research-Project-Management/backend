# ==============================================================================
# Flux Backend Environment Configuration Template
# (Copy this to .env on your VPS and fill in the values)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Settings
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Frontend / Vercel Integration & CORS
#    Set CLIENT_URL and ORIGINS to your Vercel deployment domain (no trailing slash)
# ------------------------------------------------------------------------------
CLIENT_URL=https://your-flux-app.vercel.app
API_URL=https://api.yourdomain.com
ORIGINS=https://your-flux-app.vercel.app,https://your-custom-domain.com
ALLOW_VERCEL_PREVIEW=true

# ------------------------------------------------------------------------------
# 3. Security, Encryption & Tokens (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=
ENCRYPTION_SECRET=
ZOTERO_ENCRYPTION_KEY=
URL_CAPTURE_SECRET=

# ------------------------------------------------------------------------------
# 4. Database (PostgreSQL + PgBouncer Pooler)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=
DB_NAME=flux-db
DB_PORT=5433
PGBOUNCER_PORT=6432
# App runtime connection (routed via PgBouncer for transaction connection pooling)
DATABASE_URL=postgresql://postgres:password@localhost:6432/flux-db?schema=public
# Direct connection for Prisma CLI migrations / schema push
DIRECT_URL=postgresql://postgres:password@localhost:5433/flux-db?schema=public

# ------------------------------------------------------------------------------
# 5. Redis Infrastructure (Split: Cache vs. BullMQ Queue)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_URL=redis://127.0.0.1:6379
REDIS_QUEUE_URL=redis://127.0.0.1:6380

# ------------------------------------------------------------------------------
# 6. Object Storage (S3 / Cloudflare R2 / MinIO Direct-to-Storage)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
# AWS S3 / Local MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=flux
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Or Cloudflare R2:
R2_API_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=flux

# ------------------------------------------------------------------------------
# 7. Academic Sidecars (Internal Docker Network)
# ------------------------------------------------------------------------------
GROBID_URL=http://grobid:8070
GROBID_ENABLED=true
ZOTERO_TRANSLATOR_URL=http://translator:1969
ZOTERO_TRANSLATOR_ENABLED=true

# ------------------------------------------------------------------------------
# 8. External Academic APIs & OAuth (Optional)
# ------------------------------------------------------------------------------
OPENALEX_API_KEY=
ACADEMIC_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FLUX_AI_URL=http://localhost:8000
CLSI_URL=http://localhost:3013
LATEX_URL=http://localhost:3013
