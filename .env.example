PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
SESSION_SECRET=your_session_secret_here
URL_CAPTURE_SECRET=your_url_capture_secret_at_least_32_chars_long
ZOTERO_ENCRYPTION_KEY=your_zotero_encryption_key_at_least_32_chars_long

# URLs & CORS
CLIENT_URL=http://localhost:2915
API_URL=http://localhost:3000
ORIGINS=http://localhost:2915,http://localhost:2916,http://localhost:3000,http://localhost:5173

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Storage (Cloudflare R2 / S3)
R2_API_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=flux

# Redis Cache / PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# External Microservices
FLUX_AI_URL=http://localhost:8000
LATEX_URL=http://localhost:2918

# PostgreSQL (Prisma 7)
DATABASE_URL=postgresql://user:password@localhost:5432/rpm_db?schema=public
