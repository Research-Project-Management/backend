# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb://username:password@localhost:27017/rpm?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Session Secret (Bắt buộc đổi khi lên Production)
SESSION_SECRET=your-super-secret-session-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudflare R2 Configuration (for file storage)
R2_API_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name

# AI & LaTeX Services
FLUX_AI_URL=http://localhost:3000
LATEX_URL=http://localhost:2918
