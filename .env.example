# Server Configuration
NODE_ENV=development
PORT=3000

# MongoDB Configuration (sử dụng MongoDB server có sẵn)
# Cấu hình kết nối đến MongoDB server đang chạy
MONGODB_URI=mongodb://username:password@localhost:27017/rpm?authSource=admin

# Redis Configuration (sử dụng Redis server có sẵn)
REDIS_HOST=localhost
REDIS_PORT=6379

# Session Secret (CHANGE THIS IN PRODUCTION!)
SESSION_SECRET=your-super-secret-session-key-change-this

# GitHub OAuth (Optional - for GitHub authentication)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Google OAuth (Optional - for Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# AWS/Cloudflare R2 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_REGION=auto
R2_ACCOUNT_ID=your-cloudflare-r2-account-id
R2_BUCKET_NAME=your-bucket-name
